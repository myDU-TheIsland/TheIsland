@inject DualPlayerRepository playerRepo
@model StorePurchaseHistory
@{
    ViewData["Title"] = "Purchase History Log";
    var po = Model;
}
<div class="min-h-screen pt-35 max-w-6xl mx-auto">
    <div class="bg-darkBlue text-white rounded-lg shadow-md">
        <div class="px-6 py-4 border-b border-gray-700">
            <h2 class="text-xl font-semibold">Purchase History</h2>
        </div>
        <div class="p-6">
            <div>
                <table id="detail" class="w-full text-left text-sm text-gray-300">
                    <thead>
                        <tr class="uppercase text-xs text-gray-400 font-medium border-b border-gray-600">
                            <th class="py-4 px-6">ID</th>
                            <th class="py-4 px-6">Date</th>
                            <th class="py-4 px-6">Player</th>
                            <th class="py-4 px-6">Price</th>
                            <th class="py-4 px-6">Item</th>
                            <th class="py-4 px-6">Status</th>
                            <th class="py-4 px-6 text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="max-h-60 overflow-y-auto">
                        @{
                            var playerName = (await playerRepo.GetAsync(po.player_id).ConfigureAwait(false)).display_name;
                        }
                        <tr class="border-b border-gray-700 hover:bg-slate-900">
                            <td class="py-4 px-6 font-semibold">@po.id</td>
                            <td class="py-4 px-6">@po.timestamp.ToString("g")</td>
                            <td class="py-4 px-6">@playerName</td>
                            <td class="py-4 px-6">@po.price.ToString("n0")</td>
                            <td class="py-4 px-6">@po.quantity x @po.store_item.name</td>
                            <td class="py-4 px-6">
                                @if (po.success)
                                {
                                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-gray-800 text-gray-200 border border-gray-600">Purchased</span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-red-600 text-white border border-red-800">
                                        Failed
                                    </span>
                                }
                            </td>
                            <td class="py-4 px-6 text-center">
                                <a asp-action="ViewLog" asp-controller="Store" asp-area="Admin" asp-route-purchaseId="@po.id"
                                    class="text-blue-500 hover:text-blue-700">Log</a>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Logs Table -->
            <div class="max-w-6xl mx-auto pt-5">
                <div class="bg-darkBlue text-white">
                    <div>
                        <table class="w-full table-fixed text-left text-sm text-gray-300">
                            <thead class="uppercase text-xs text-gray-400 font-medium border-b border-gray-600">
                                <tr>
                                    <th class="py-4 px-6 w-full">Log Entry</th>
                                </tr>
                            </thead>
                        </table>
            
                        <!-- Wrap tbody in a scrollable container -->
                        <div class="max-h-64 overflow-y-auto">
                            <table class="w-full table-fixed text-left text-sm text-gray-300">
                                <tbody class="divide-y divide-gray-700">
                                    @foreach (var logEntry in po.log)
                                    {
                                        <tr class="border-b border-gray-700 hover:bg-slate-900">
                                            <td class="py-4 px-6 w-full">@logEntry</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const logsTable = document.getElementById('logs');
            if (logsTable) {
                // Apply any necessary JavaScript functionality here if needed
                // This placeholder is used if you want to add any JavaScript interactions
                console.log("Logs table loaded successfully.");
            }
        });
    </script>
}
