@{
    ViewData["Title"] = "Home Page";
    ViewBag.InsertGutter = true;
}
<div
    class="pt-35 flex md:flex-row xs:flex-col justify-center max-w-7xl mx-auto md:space-x-3 md:space-y-0 xs:space-x-0 xs:space-y-3 xs:px-3">

    <div class="bg-darkBlue rounded-md text-center p-5">
        <a asp-action="List" asp-controller="Store" asp-area="Admin">
            <h5 class="card-title">List</h5>
            <i class="fas fa-shop fa-6x"></i>
        </a>
    </div>
    <div class="bg-darkBlue rounded-md text-center p-5">
        <a asp-action="Add" asp-controller="Store" asp-area="Admin">
            <h5 class="card-title">Add Item</h5>
            <i class="fas fa-shop fa-6x"></i>
        </a>
    </div>
    <div class="bg-darkBlue rounded-md text-center p-5">
        <a asp-action="History" asp-controller="Store" asp-area="Admin">
            <h5 class="card-title">Purchase History</h5>
            <i class="fas fa-arrow-trend-up fa-6x"></i>
        </a>
    </div>

</div>