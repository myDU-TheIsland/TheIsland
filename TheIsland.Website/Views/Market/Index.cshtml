@inject IMarketBot _marketBot
@inject IGeneralBot _generalBot
@inject DualMarketRepository _marketRepo
@inject MarketService _marketService
@model MarketModel
@{
    ViewData["Title"] = "Market Data";

    var items = _marketBot.GetListOfSellableItems().OrderBy(items => items.Value).ToDictionary();

    var markets = (await _marketRepo.GetAsync().ConfigureAwait(false)).ToDictionary(key => key.id, value =>
    value.name.Replace("Market", string.Empty).Replace("District", string.Empty).Trim());
    markets.Add(0, "All Markets");

    var itemExists = items.ContainsKey(Model.ItemId);
    var selectedMarket = markets[Model.MarketId];
    var selectedItem = itemExists ? items[Model.ItemId] : string.Empty;

    double botPurchasePrice = _marketBot.GetItemPrice(Convert.ToUInt64(Model.MarketId), Convert.ToUInt64(Model.ItemId)) / 100;
    double botLimit = await _marketBot.GetItemLimitAsync(Model.ItemId);
    double userLimit = botLimit - ((await _marketBot.GetPlayerItemLimitAsync(this.SelectedPlayer, Model.MarketId, Model.ItemId))?.quantity ?? 0); 

    string graphHeader = markets.ContainsKey(Model.MarketId) ? " @ " + markets[Model.MarketId] : string.Empty;
}

<div class="min-h-screen text-white font-sans pt-35">
    <div class="max-w-7xl mx-auto space-y-4">
        <!-- Navigation Bar -->
        <div class="text-white rounded-lg">
            <nav class="bg-darkBlue p-2 rounded-lg shadow-lg border border-purple-500/30">
                <div class="flex items-center space-x-2">

                    <div class="relative w-1/3 dropdown-container">
                        <!-- Item Dropdown with Search (using Select2) -->
                        <select asp-for="ItemId" id="dropdownSearch"
                            class="block w-full px-4 py-2 text-white bg-gray-700 rounded-md focus:outline-none focus:ring-2 focus:ring-purple-600">
                            <option value="">Search Item...</option>
                            @foreach (var item in items)
                            {
                                <option value="@item.Key">@item.Value</option>
                            }
                        </select>
                    </div>

                    <div class="relative w-1/3 dropdown-container-2">
                        <!-- Market Dropdown using Select2 -->
                        <select asp-for="MarketId" id="marketSearch" name="MarketId"
                            class="block w-full px-4 py-2 text-white bg-gray-700 rounded-md focus:outline-none focus:ring-2 focus:ring-purple-600">
                            <option value="0">All Markets</option> <!-- Default option for All Markets -->
                            @foreach (var market in markets.OrderBy(item => item.Value).ToArray())
                            {
                                <option value="@market.Key">@market.Value</option>
                            }
                        </select>
                    </div>

                    <!-- Search Button -->
                    <button id="btnSearch"
                        class="px-4 py-2 bg-purple-600 rounded-md text-white hover:bg-purple-500 ml-2">Search</button>

                    <!-- Hidden inputs to store selected IDs -->
                    <input type="hidden" id="selectedItemId" name="ItemId" value="">
                    <input type="hidden" id="selectedMarketId" name="MarketId" value="0">

                </div>
            </nav>
        </div>

        <!-- Main Content Grid -->
        <div class="flex flex-col space-y-4">
            @if (itemExists)
            {
                string varyByString = $@"{Model.ItemId}/{Model.MarketId}";

                var orders = itemExists ? await this._marketService.GetAllActiveAsync(Model.MarketId,
                Model.ItemId).ConfigureAwait(false) : Enumerable.Empty<MarketTransaction>();
                var buyOrders = orders.Where(item => item.type == TheIsland.Core.Entities.TransactionType.BuyOrder);
                var sellOrders = orders.Where(item => item.type == TheIsland.Core.Entities.TransactionType.SellOrder);

                @* <!-- Chart Section --> *@
                <div class="bg-darkBlue rounded-lg shadow-lg px-2 py-3 border border-purple-500/30">
                    <h2 class="text-2xl font-bold mb-4 text-white">@items[Model.ItemId] (Last 72hrs) @graphHeader
                    </h2>
                    @if (botPurchasePrice > 0)
                    {
                        <p class="text-purple-400 mb-4 pb-4">
                            ⭐ <i>Honjos Minion is buying at
                                @botPurchasePrice quanta per unit</i> 
                            
                            @if (botLimit > 0)
                            {
                                    <i>
                                        @Html.Raw(@$", they will only buy {botLimit.ToString("n0")} units")
                                        @if (userLimit > 0 && Model.MarketId != 0)
                                        {
                                            @Html.Raw(@$"(you can still sell {@userLimit.ToString("n0")} units)")
                                        }
                                    </i>
                            }
                            ⭐
                            </p>
                    }
                    <div class="border border-purple-500 w-full"></div>
                    <canvas id="priceChart" class="pt-5" style="max-height: 300px;"></canvas>
                </div>

                @* <!-- Orders Section --> *@
                <div class="flex w-full space-x-4">
                    @* <!-- Buy Orders --> *@
                    <div id="buyOrdersSection" class="bg-darkBlue rounded-lg w-1/2 shadow-lg border border-purple-500/30">
                        <div class="p-4 bg-purple-600 rounded-lg">
                            <h2 class="text-xl font-bold text-white">Buy Orders</h2>
                        </div>
                        <div class="p-4">
                            <table class="w-full">
                                <thead>
                                    <tr class="border-b border-purple-500 text-left text-purple-400">
                                        <th class="pb-2 w-1/3 sortable cursor-pointer" data-column="price"
                                            data-target="buyOrdersTable">Unit Price <span
                                                class="inline-block ml-1">▲▼</span></th>
                                        <th class="pb-2 w-1/3 sortable cursor-pointer" data-column="quantity"
                                            data-target="buyOrdersTable">Quantity <span class="inline-block ml-1">▲▼</span>
                                        </th>
                                        <th class="pb-2 w-1/3 sortable cursor-pointer" data-column="market"
                                            data-target="buyOrdersTable">Market <span class="inline-block ml-1">▲▼</span>
                                        </th>
                                    </tr>
                                </thead>
                            </table>
                            <div class="overflow-y-auto max-h-80">
                                <table class="w-full">
                                    <tbody id="buyOrdersTable" class="text-white">
                                        @foreach (var buyOrder in buyOrders)
                                        {
                                            <tr class="border-b border-purple-500/40">
                                                <td class="py-2 w-1/3">@((buyOrder.price) / 100)</td>
                                                <td class="py-2 w-1/3">@Math.Abs(buyOrder.quantity)</td>
                                                <td class="py-2 w-1/3">@markets[buyOrder.market_id]</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    @* <!-- Sell Orders --> *@
                    <div id="sellOrdersSection" class="bg-darkBlue rounded-lg w-1/2 shadow-lg border border-purple-500/30">
                        <div class="p-4 bg-purple-600 rounded-lg">
                            <h2 class="text-xl font-bold text-white">Sell Orders</h2>
                        </div>
                        <div class="p-4">
                            <table class="w-full">
                                <thead class="bg-darkBlue">
                                    <tr class="border-b border-purple-500 text-left text-purple-400">
                                        <th class="pb-2 w-1/3 sortable cursor-pointer" data-column="price"
                                            data-target="sellOrdersTable">Unit Price <span
                                                class="inline-block ml-1">▲▼</span></th>
                                        <th class="pb-2 w-1/3 sortable cursor-pointer" data-column="quantity"
                                            data-target="sellOrdersTable">Quantity <span class="inline-block ml-1">▲▼</span>
                                        </th>
                                        <th class="pb-2 w-1/3 sortable cursor-pointer" data-column="market"
                                            data-target="sellOrdersTable">Market <span class="inline-block ml-1">▲▼</span>
                                        </th>
                                    </tr>
                                </thead>
                            </table>
                            <div class="overflow-y-auto max-h-80">
                                <table class="w-full">
                                    <tbody id="sellOrdersTable" class="text-white">
                                        @foreach (var sellOrder in sellOrders)
                                        {
                                            <tr class="border-b border-purple-500/40">
                                                <td class="py-2 w-1/3">@((sellOrder.price) / 100)</td>
                                                <td class="py-2 w-1/3">@Math.Abs(sellOrder.quantity)</td>
                                                <td class="py-2 w-1/3">@markets[sellOrder.market_id]</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                    </div>

                </div>
            }
        </div>
    </div>

</div>
<script>
    $(window).on('load', function () {
        // Initialize Select2 for Item dropdown
        $('#dropdownSearch').select2({
            placeholder: "Search Item...",
            allowClear: true,
            dropdownParent: $('.dropdown-container')
        }).on('select2:open', function () {
            focusSelect2SearchField('#dropdownSearch');
        });

        // Initialize Select2 for Market dropdown
        $('#marketSearch').select2({
            placeholder: "Search Markets...",
            allowClear: true,
            dropdownParent: $('.dropdown-container-2')
        }).on('select2:open', function () {
            focusSelect2SearchField('#marketSearch');
        });
    });

    $(document).ready(function () {
        // On Search button click, determine URL based on selected values
        $("#btnSearch").on("click", function () {
            // Get selected item and market values
            var itemId = $("#dropdownSearch").val();
            var marketId = $("#marketSearch").val();

            // Check if item is selected (non-zero) and perform the redirect
            if (itemId == 0) return; // Exit if no item is selected
            if (marketId == 0) {
                // Redirect to /Market/{itemId} if no market selected
                window.location.replace("/Market/" + itemId);
            } else if (marketId > 0) {
                // Redirect to /Market/{itemId}/{marketId} if market selected
                window.location.replace("/Market/" + itemId + "/" + marketId);
            }
        });
    });

    // Function to focus the Select2 search field using MutationObserver
    function focusSelect2SearchField(select2Id) {
        // Set up MutationObserver to detect when the dropdown is open
        const observer = new MutationObserver(() => {
            const searchField = document.querySelector('.select2-container--open .select2-search__field');
            if (searchField) {
                searchField.focus();
                observer.disconnect(); // Stop observing once focused
            }
        });

        // Observe changes to the body to detect dropdown open state
        observer.observe(document.body, { childList: true, subtree: true });
    }

    $(document).ready(function () {
        // Track current sort order for each table and column
        let sortOrder = {};

        // Function to sort table rows based on a column and order
        function sortTable(tableId, column, order) {
            const rows = $('#' + tableId + ' tr').get();

            rows.sort(function (a, b) {
                const cellA = $(a).children('td').eq(column).text();
                const cellB = $(b).children('td').eq(column).text();

                let valA = column === 0 || column === 1 ? parseFloat(cellA) : cellA;
                let valB = column === 0 || column === 1 ? parseFloat(cellB) : cellB;

                if (order === 'asc') {
                    return valA > valB ? 1 : valA < valB ? -1 : 0;
                } else {
                    return valA < valB ? 1 : valA > valB ? -1 : 0;
                }
            });

            // Append sorted rows back to the table
            $.each(rows, function (index, row) {
                $('#' + tableId).append(row);
            });
        }

        // Event listeners for sorting when header is clicked
        $('.sortable').on('click', function () {
            const column = $(this).index(); // Column index
            const targetTable = $(this).data('target'); // Target table ID
            const columnName = $(this).data('column'); // Column name

            // Initialize sort order if not set
            if (!sortOrder[targetTable]) {
                sortOrder[targetTable] = {};
            }
            if (!sortOrder[targetTable][columnName]) {
                sortOrder[targetTable][columnName] = 'asc';
            } else {
                // Toggle sort order
                sortOrder[targetTable][columnName] = sortOrder[targetTable][columnName] === 'asc' ? 'desc' : 'asc';
            }

            // Update sort indicator
            $(`[data-target="${targetTable}"] span`).text('▲▼'); // Reset other columns
            $(this).find('span').text(sortOrder[targetTable][columnName] === 'asc' ? '▲' : '▼');

            // Sort the table based on selected column and order
            sortTable(targetTable, column, sortOrder[targetTable][columnName]);
        });
    });
</script>

@if (itemExists)
{
    string uri = "";
    if (Model.MarketId > 0)
    {
        uri = $@"/Api/Market/Daily/{Model.ItemId}/{Model.MarketId}/?type=chartjs";
    }
    else
    {
        uri = $@"/Api/Market/Daily/{Model.ItemId}/-1?type=chartjs";
    }
    <text>
        <script>
            $(document).ready(function () {
                const uri = "@uri";

                // Chart.js for displaying price trends
                const ctx = document.getElementById('priceChart').getContext('2d');

                // Initialize an empty Chart.js chart
                const priceChart = new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: [], // Labels will be populated dynamically
                        datasets: [
                            {
                                label: 'Total Sold',
                                data: [], // Data will be populated dynamically
                                borderColor: '#8884d8',
                                backgroundColor: 'rgba(136, 132, 216, 0.2)',
                                yAxisID: 'y1',
                                tension: 0.4,
                                pointRadius: 5,
                                pointBackgroundColor: '#8884d8',
                            },
                            {
                                label: 'Average Price',
                                data: [], // Data will be populated dynamically
                                borderColor: '#82ca9d',
                                backgroundColor: 'rgba(130, 202, 157, 0.2)',
                                yAxisID: 'y2',
                                tension: 0.4,
                                pointRadius: 5,
                                pointBackgroundColor: '#82ca9d',
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            x: {
                                title: {
                                    display: true,
                                    text: 'Day'
                                }
                            },
                            y1: {
                                type: 'linear',
                                position: 'left',
                                beginAtZero: true,
                                title: {
                                    display: true,
                                    text: 'Total Sold'
                                }
                            },
                            y2: {
                                type: 'linear',
                                position: 'right',
                                beginAtZero: true,
                                title: {
                                    display: true,
                                    text: 'Average Price'
                                },
                                grid: {
                                    drawOnChartArea: false // Prevent grid lines from overlapping
                                }
                            }
                        },
                        plugins: {
                            legend: {
                                display: true,
                                position: 'top'
                            },
                            tooltip: {
                                mode: 'index',
                                intersect: false,
                            }
                        }
                    }
                });

                // Fetch data and update the chart using jQuery's AJAX
                function fetchDataAndRenderChart() {
                    $.ajax({
                        url: uri,
                        method: 'GET',
                        dataType: 'json',
                        success: function (realData) {
                            // Transform the data
                            const labels = realData.labels;
                            const totalSoldData = realData.datasets[0].data;
                            const averagePriceData = realData.datasets[1].data;

                            // Update chart data
                            priceChart.data.labels = labels;
                            priceChart.data.datasets[0].data = totalSoldData;
                            priceChart.data.datasets[1].data = averagePriceData;

                            // Refresh chart
                            priceChart.update();
                        },
                        error: function (xhr, status, error) {
                            console.error('Error fetching chart data:', error);
                        }
                    });
                }

                // Fetch data and render chart on page load
                fetchDataAndRenderChart();
            });
        </script>
    </text>
}
