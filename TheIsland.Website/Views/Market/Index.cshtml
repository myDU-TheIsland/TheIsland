@inject IMarketBot _marketBot
@inject IGeneralBot _generalBot
@inject DualMarketRepository _marketRepo
@inject MarketService _marketService
@model MarketModel
@{
    ViewData["Title"] = "Market Data";

    var items = _generalBot.GetListOfSellableItems().OrderBy(items => items.Value).ToDictionary();

    var markets = (await _marketRepo.GetAsync().ConfigureAwait(false)).ToDictionary(key => key.id, value =>
    value.name.Replace("Market", string.Empty).Replace("District", string.Empty).Trim());
    markets.Add(0, "All Markets");

    var itemExists = items.ContainsKey(Model.ItemId);
    var selectedMarket = markets[Model.MarketId];
    var selectedItem = itemExists ? items[Model.ItemId] : string.Empty;

    double botPurchasePrice = _marketBot.GetItemPrice(Convert.ToUInt64(Model.MarketId), Convert.ToUInt64(Model.ItemId)) /
    100;

    string graphHeader = markets.ContainsKey(Model.MarketId) ? " @ " + markets[Model.MarketId] : string.Empty;
}

<div class="min-h-screen text-white font-sans overflow-y-hidden">
    <div class="max-w-7xl mx-auto space-y-5 min-h-screen">
        <!-- Navigation Bar -->
        <div class="text-white rounded-lg">
            <nav class="bg-darkBlue p-2 rounded-lg shadow-lg border border-purple-500/30">
                <div class="flex items-center space-x-2">

                    <div class="relative w-1/3">
                        <!-- Item Dropdown with Search Input -->
                        <input type="text" id="dropdownSearch" placeholder="Search Item..."
                            class="block w-full px-4 py-2 text-white bg-gray-700 rounded-md focus:outline-none focus:ring-2 focus:ring-purple-600"
                            onfocus="showDropdown('dropdownMenu')" onkeyup="debouncedFilterOptions()">
                        <input type="hidden" asp-for="ItemId" id="selectedItemId" name="ItemId">
                        <div class="absolute z-10 mt-2 w-full bg-[#2a2a3e] rounded-md shadow-lg max-h-80 overflow-y-auto hidden"
                            id="dropdownMenu">
                            <ul id="dropdownOptions">
                                @foreach (var item in items)
                                {
                                    <li class="px-4 py-2 text-white hover:bg-purple-600 cursor-pointer"
                                        data-value="@item.Key"
                                        onclick="selectOption('@item.Value.Replace("'", "\\'")', '@item.Key', 'dropdownSearch', 'dropdownMenu')">
                                        @item.Value
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>

                    <div class="relative w-1/3">
                        <!-- Market Dropdown with Search Input -->
                        <input type="text" id="marketSearch" placeholder="Select Market..." value="All Markets" class="block w-full px-4 py-2 text-white bg-gray-700 rounded-md focus:outline-none focus:ring-2
                        focus:ring-purple-600" onfocus="showDropdown('marketDropDown')"
                            onkeyup="debouncedMarketFilter()">
                        <!-- Hidden input to store selected market ID -->
                        <input type="hidden" id="selectedMarketId" name="MarketId" value="0">
                        <!-- Default value 0 (All Markets) -->
                        <div class="absolute z-10 mt-2 w-full bg-[#2a2a3e] rounded-md shadow-lg max-h-80 overflow-y-auto hidden"
                            id="marketDropDown">
                            <ul id="marketOptions">
                                @foreach (var market in markets.OrderBy(item => item.Value).ToArray())
                                {
                                    <li class="px-4 py-2 text-white hover:bg-purple-600 cursor-pointer"
                                        data-value="@market.Key"
                                        onclick="selectOption('@market.Value', '@market.Key', 'marketSearch', 'marketDropDown')">
                                        @market.Value
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>

                    <!-- Search Button -->
                    <button onclick="updateMarketPage()"
                        class="px-4 py-2 bg-purple-600 rounded-md text-white hover:bg-purple-500 ml-2">Search</button>

                    <!-- Hidden inputs to store selected IDs -->
                    <input type="hidden" id="selectedItemId" name="ItemId" value="">
                    <input type="hidden" id="selectedMarketId" name="MarketId" value="0">

                </div>
            </nav>
        </div>

        <!-- Main Content Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
            @if (itemExists)
            {
                string varyByString = $@"{Model.ItemId}/{Model.MarketId}";

                var orders = itemExists ? await this._marketService.GetAllActiveAsync(Model.MarketId,
                Model.ItemId).ConfigureAwait(false) : Enumerable.Empty<MarketTransaction>();
                var buyOrders = orders.Where(item => item.type == TheIsland.Core.Entities.TransactionType.BuyOrder);
                var sellOrders = orders.Where(item => item.type == TheIsland.Core.Entities.TransactionType.SellOrder);

                @* <!-- Orders Section --> *@
                <div class="space-y-5">
                    @* <!-- Buy Orders --> *@
                    <div id="buyOrdersSection" class="bg-darkBlue rounded-lg shadow-lg border border-purple-500/30">
                        <div class="p-4 bg-purple-600 rounded-lg">
                            <h2 class="text-xl font-bold text-white">Buy Orders</h2>
                        </div>
                        <div class="p-4">
                            <table class="w-full">
                                <thead>
                                    <tr class="border-b border-purple-500 text-left text-purple-400">
                                        <th class="pb-2 w-1/3">Unit Price <span class="inline-block ml-1">▲▼</span></th>
                                        <th class="pb-2 w-1/3">Quantity <span class="inline-block ml-1">▲▼</span></th>
                                        <th class="pb-2 w-1/3">Market <span class="inline-block ml-1">▲▼</span></th>
                                    </tr>
                                </thead>
                            </table>

                            <div class="overflow-y-auto max-h-80">
                                <table class="w-full">
                                    <tbody class="text-white">
                                        @* Buy order rows *@
                                        @foreach (var buyOrder in buyOrders)
                                        {
                                            <tr class="border-b border-purple-500/40">
                                                <td class="py-2 w-1/3">@((buyOrder.price) / 100)</td>
                                                <td class="py-2 w-1/3">@Math.Abs(buyOrder.quantity)</td>
                                                <td class="py-2 w-1/3">@markets[buyOrder.market_id]</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    @* <!-- Sell Orders --> *@
                    <div id="sellOrdersSection" class="bg-darkBlue rounded-lg shadow-lg border border-purple-500/30">
                        <div class="p-4 bg-purple-600 rounded-lg">
                            <h2 class="text-xl font-bold text-white">Sell Orders</h2>
                        </div>
                        <div class="p-4">
                            <table class="w-full">
                                <thead class="bg-darkBlue">
                                    <tr class="border-b border-purple-500 text-left text-purple-400">
                                        <th class="pb-2 w-1/3">Unit Price <span class="inline-block ml-1">▲▼</span></th>
                                        <th class="pb-2 w-1/3">Quantity <span class="inline-block ml-1">▲▼</span></th>
                                        <th class="pb-2 w-1/3">Market <span class="inline-block ml-1">▲▼</span></th>
                                    </tr>
                                </thead>
                            </table>

                            <div class="overflow-y-auto max-h-80">
                                <table class="w-full">
                                    <tbody id="sellOrdersTable" class="text-white">
                                        @foreach (var sellOrder in sellOrders)
                                        {
                                            <tr class="border-b border-purple-500/40">
                                                <td class="py-2 w-1/3">@((sellOrder.price) / 100)</td>
                                                <td class="py-2 w-1/3">@Math.Abs(sellOrder.quantity)</td>
                                                <td class="py-2 w-1/3">@markets[sellOrder.market_id]</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                </div>

                @* <!-- Chart Section --> *@
                <div class="bg-darkBlue rounded-lg shadow-lg px-3 py-3 border border-purple-500/30 max-h-100">
                    <h2 class="text-2xl font-bold mb-4 text-white">@items[Model.ItemId] (Last 72hrs) @graphHeader
                    </h2>
                    @if (botPurchasePrice > 0)
                    {
                        <p class="text-purple-400 mb-4 border-b border-purple-500 pb-4">⭐ <i>Honjos Minion is buying at
                                @botPurchasePrice quanta per unit</i> ⭐</p>
                    }
                    <canvas id="priceChart" class="pt-10" style="max-height: 300px;"></canvas>
                </div>
            }
        </div>
    </div>

</div>
<script>
    function showDropdown(dropdownId) {
        const dropdown = document.getElementById(dropdownId);
        if (dropdown) dropdown.classList.remove('hidden');
    }

    function selectOption(text, value, inputId, dropdownId) {
        const inputElement = document.getElementById(inputId);
        const dropdown = document.getElementById(dropdownId);

        if (inputElement) {
            inputElement.value = text; // Show selected name in the input field
            if (inputId === 'dropdownSearch') {
                document.getElementById('selectedItemId').value = value; // Store item ID in hidden input to bind to model
            } else if (inputId === 'marketSearch') {
                document.getElementById('selectedMarketId').value = value; // Store market ID in hidden input to bind to model
            }
        }
        if (dropdown) dropdown.classList.add('hidden');
    }

    function updateMarketPage() {
        const itemId = document.getElementById('selectedItemId').value || ""; // Get item ID from hidden input
        const marketId = document.getElementById('selectedMarketId').value || "0"; // Get market ID from hidden input

        if (!itemId) {
            console.log("No item selected");
            return; // Exit if no item is selected
        }

        // Redirect based on selected item and market ID without changing the display value
        if (marketId === "0") {
            window.location.replace(`/Market/${itemId}`);
        } else {
            window.location.replace(`/Market/${itemId}/${marketId}`);
        }
    }

    document.addEventListener("DOMContentLoaded", function () {
        // Set default selection for the market dropdown
        const marketSearchInput = document.getElementById('marketSearch');
        const selectedMarketIdInput = document.getElementById('selectedMarketId');

        // Set the displayed text to "All Markets" and hidden value to 0
        marketSearchInput.value = "All Markets";
        selectedMarketIdInput.value = "0";
    });

    document.addEventListener("DOMContentLoaded", function () {
        const dropdownSearch = document.getElementById('dropdownSearch');
        const dropdownMenu = document.getElementById('dropdownMenu');
        const marketSearch = document.getElementById('marketSearch');
        const marketDropDown = document.getElementById('marketDropDown');

        // Filter function for items
        function filterOptions() {
            if (!dropdownMenu) return;
            const filter = dropdownSearch.value.toLowerCase();
            const dropdownOptions = dropdownMenu.getElementsByTagName('li');

            for (let i = 0; i < dropdownOptions.length; i++) {
                const txtValue = dropdownOptions[i].textContent || dropdownOptions[i].innerText;
                dropdownOptions[i].style.display = txtValue.toLowerCase().includes(filter) ? '' : 'none';
            }
        }

        // Filter function for markets
        function filterMarketOptions() {
            if (!marketDropDown) return;
            const filter = marketSearch.value.toLowerCase();
            const marketOptions = marketDropDown.getElementsByTagName('li');

            for (let i = 0; i < marketOptions.length; i++) {
                const txtValue = marketOptions[i].textContent || marketOptions[i].innerText;
                marketOptions[i].style.display = txtValue.toLowerCase().includes(filter) ? '' : 'none';
            }
        }

        // Debounce function to optimize search
        function debounce(func, delay) {
            let debounceTimeout;
            return function (...args) {
                clearTimeout(debounceTimeout);
                debounceTimeout = setTimeout(() => func.apply(this, args), delay);
            };
        }

        const debouncedFilterOptions = debounce(filterOptions, 300);
        const debouncedMarketFilter = debounce(filterMarketOptions, 300);

        if (dropdownSearch) dropdownSearch.addEventListener('keyup', debouncedFilterOptions);
        if (marketSearch) marketSearch.addEventListener('keyup', debouncedMarketFilter);

        // Close dropdown if clicking outside
        document.addEventListener('click', (event) => {
            if (dropdownMenu && !event.target.closest('#dropdownSearch') && !event.target.closest('#dropdownMenu')) {
                dropdownMenu.classList.add('hidden');
            }
            if (marketDropDown && !event.target.closest('#marketSearch') && !event.target.closest('#marketDropDown')) {
                marketDropDown.classList.add('hidden');
            }
        });
    });

</script>
@if (itemExists)
{
    <text>
        <script>
            // Use the hardcoded URL directly for now
            const uri = "https://www.theisle.online/Api/Market/Daily/@Model.ItemId/-1?type=chartjs";

            // Chart.js for displaying price trends
            const ctx = document.getElementById('priceChart').getContext('2d');

            // Initialize an empty Chart.js chart
            const priceChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: [], // Labels will be populated dynamically
                    datasets: [
                        {
                            label: 'Total Sold',
                            data: [], // Data will be populated dynamically
                            borderColor: '#8884d8',
                            backgroundColor: 'rgba(136, 132, 216, 0.2)',
                            yAxisID: 'y1',
                            tension: 0.4,
                            pointRadius: 5,
                            pointBackgroundColor: '#ffffff',
                        },
                        {
                            label: 'Average Price',
                            data: [], // Data will be populated dynamically
                            borderColor: '#82ca9d',
                            backgroundColor: 'rgba(130, 202, 157, 0.2)',
                            yAxisID: 'y2',
                            tension: 0.4,
                            pointRadius: 5,
                            pointBackgroundColor: '#ffffff',
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        x: {
                            title: {
                                display: true,
                                text: 'Day'
                            }
                        },
                        y1: {
                            type: 'linear',
                            position: 'left',
                            beginAtZero: true,
                            title: {
                                display: true,
                                text: 'Total Sold'
                            }
                        },
                        y2: {
                            type: 'linear',
                            position: 'right',
                            beginAtZero: true,
                            title: {
                                display: true,
                                text: 'Average Price'
                            },
                            grid: {
                                drawOnChartArea: false // Prevent grid lines from overlapping
                            }
                        }
                    },
                    plugins: {
                        legend: {
                            display: true,
                            position: 'top'
                        },
                        tooltip: {
                            mode: 'index',
                            intersect: false,
                        }
                    }
                }
            });

            // Fetch data and update the chart
            async function fetchDataAndRenderChart() {
                try {
                    const response = await fetch(uri);
                    if (!response.ok) throw new Error(`HTTP error! Status: ${response.status}`);
                    const realData = await response.json();

                    console.log(realData);

                    // Transform the data
                    const labels = realData.rows.map(row => new Date(row.c[0].v).toLocaleDateString()).reverse(); // Adjust format and reverse
                    const totalSoldData = realData.rows.map(row => row.c[1].v).reverse(); // Reverse the data array
                    const averagePriceData = realData.rows.map(row => row.c[2].v).reverse(); // Reverse the data array

                    // Update chart data
                    priceChart.data.labels = labels;
                    priceChart.data.datasets[0].data = totalSoldData;
                    priceChart.data.datasets[1].data = averagePriceData;

                    // Refresh chart
                    priceChart.update();
                } catch (error) {
                    console.error('Error fetching chart data:', error);
                }
            }

            // Fetch data and render chart on page load
            window.onload = fetchDataAndRenderChart;
        </script>
    </text>
}
