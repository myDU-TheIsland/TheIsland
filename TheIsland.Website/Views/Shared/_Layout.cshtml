@using System.Security.Claims
@using Microsoft.AspNetCore.Http;
@{
    bool hasPlayerInfo = this.SelectedPlayer != 0;
    string discordId = this.DiscordId;
    var players = await this.PlayerLinkingService.GetPlayerMapping(discordId).ConfigureAwait(false);

    bool? addGutterWrapper = ViewBag.InsertGutter as bool?;
    bool addGutter = addGutterWrapper != null && addGutterWrapper == true;

    string wrapperClass = addGutter ? "container" : "container-fluid";
    string currentPlayerName = players.FirstOrDefault(item => item.dual_id == this.SelectedPlayer)?.player_name ?? "User";
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - The Island</title>
    <meta content='width=device-width, initial-scale=1.0, shrink-to-fit=no' name='viewport' />
    <!--     Fonts and icons     -->
    <link rel="stylesheet" type="text/css"
        href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700|Roboto+Slab:400,700|Material+Icons" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css"
        integrity="sha512-Kc323vGBEqzTmouAECnVceyQqyqdsSiqLQISBL29aUW4U/M7pSPA/gEUZQqv1cwx4OnYxTxve5UMg5GT6L4JJg=="
        crossorigin="anonymous" referrerpolicy="no-referrer" />
    <!-- CSS Files -->
    <link href="~/css/style.css" rel="stylesheet">
    <!-- JS Files -->
    <script src="~/js/site.js"></script>
    <!-- Chartjs -->
    <script src="https://cdn.jsdelivr.net/npm/luxon@3.4.4"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-luxon@1.3.1"></script>
    <script src="https://www.chartjs.org/chartjs-chart-financial/chartjs-chart-financial.js"></script>

    @await RenderSectionAsync("Head", required: false)
</head>

<body className="min-h-screen bg-gray-900 text-white font-sans">
    <header class="bg-black/50 backdrop-blur-md fixed top-0 left-0 right-0 z-50">
        <nav class="container mx-auto px-4 py-4 flex items-center justify-between">
            <div class="flex items-center">
                <img src="/img/honjo-logo.png" style="height: 70px; padding-right: 8px;" />
                <a href="~/"
                    class="text-3xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-pink-600">
                    The Isle
                </a>
            </div>
            <div class="hidden md:flex items-center space-x-5">
                <a href="https://discord.gg/6zsBcDX5Rz" target="_blank"
                    class="text-gray-300 hover:text-purple-400 transition-colors">OUR DISCORD</a>
                <a href="~/Market/Index" class="text-gray-300 hover:text-purple-400 transition-colors">MARKET</a>
                @if (hasPlayerInfo)
                {
                    <a asp-controller="Store" asp-action="Index" asp-area=""
                        class="text-gray-300 hover:text-purple-400 transition-colors">STORE</a>
                }
                <a href="https://wiki.theisle.online" target="_blank"
                    class="text-gray-300 hover:text-purple-400 transition-colors">WIKI</a>
                <a href="https://www.paypal.com/donate/?hosted_button_id=SGK46VC2GYFM2" target="_blank"
                    class="text-gray-300 hover:text-purple-400 transition-colors">DONATE</a>
                @if (!this.IsLoggedIn)
                {
                    <a asp-controller="Authentication" asp-action="Signin"
                        class="text-gray-300 hover:text-purple-400 transition-colors pl-5">SIGN IN</a>
                }
                else
                {
                    <div class="relative">
                        <button class="flex items-center text-gray-300 hover:text-purple-400 transition-colors"
                            id="userDropdownButton" onclick="toggleDropdown()">
                            Hi, @currentPlayerName
                            <svg class="ml-2 h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20"
                                fill="currentColor" aria-hidden="true">
                                <path fill-rule="evenodd"
                                    d="M5.23 7.21a.75.75 0 011.06.02L10 10.94l3.71-3.71a.75.75 0 111.06 1.06l-4 4a.75.75 0 01-1.06 0l-4-4a.75.75 0 01.02-1.06z"
                                    clip-rule="evenodd" />
                            </svg>
                        </button>
                        <div id="userDropdownMenu"
                            class="absolute right-0 mt-2 w-60 bg-gray-900 text-white font-sans rounded-md shadow-lg py-2 z-10 hidden">
                            @if (currentPlayerName != "User")
                            {
                                <form id="playerChange" asp-action="SetPlayerId" asp-controller="User" method="post"
                                    class="px-4 py-2">
                                    @{
                                        var selectedPlayer = this.SelectedPlayer;
                                    }
                                    <select name="playerId" id="playerSelection"
                                        class="w-full bg-gray-700 p-2 rounded border-gray-600">
                                        @foreach (var player in players)
                                        {
                                            if (player.dual_id == @selectedPlayer)
                                            {
                                                <option value="@player.dual_id" selected>@player.player_name</option>
                                            }
                                            else
                                            {
                                                <option value="@player.dual_id">@player.player_name</option>
                                            }
                                        }
                                    </select>
                                </form>
                                <div class="border-t border-gray-600 my-2"></div>
                            }
                            @if (this.IsAdmin)
                            {
                                <a asp-area="Admin" asp-controller="Admin" asp-action="Index"
                                    class="block px-4 py-2 text-gray-100 hover:bg-purple-500">
                                    Admin Center
                                </a>
                                <div class="border-t border-gray-600 my-2"></div>
                            }
                            <a asp-area="" asp-controller="User" asp-action="Link"
                                class="block px-4 py-2 text-gray-100 hover:bg-purple-500">
                                Link Game Account(s)
                            </a>
                            @if (hasPlayerInfo)
                            {

                                <a asp-area="" asp-controller="User" asp-action="ImportBP"
                                    class="block px-4 py-2 text-gray-100 hover:bg-purple-500">Import
                                    Blueprints</a>
                                <a asp-area="" asp-controller="User" asp-action="ExportBP"
                                    class="block px-4 py-2 text-gray-100 hover:bg-purple-500">Export
                                    Blueprints</a>
                            }
                            <a asp-area="" asp-controller="Store" asp-action="History"
                                class="block px-4 py-2 text-gray-100 hover:bg-purple-500">
                                Player Purchase History
                            </a>
                            <a asp-controller="Authentication" asp-action="SignOutCurrentUser"
                                class="block px-4 py-2 text-gray-100 hover:bg-purple-500">
                                Logout
                            </a>
                        </div>
                    </div>
                }

            </div>
        </nav>
    </header>
    <div class="min-h-screen bg-dark relative text-white font-sans">
        <div class="absolute inset-0 overflow-hidden">
            <div class="stars"></div>
            <div class="stars2"></div>
            <div class="stars3"></div>
        </div>
        <div class="relative z-10">
            @RenderBody()
        </div>
    </div>
    <script>
        function toggleDropdown() {
            document.getElementById("userDropdownMenu").classList.toggle("hidden");
        }

        // Close dropdown when clicking outside
        window.addEventListener("click", function (e) {
            const dropdownButton = document.getElementById("userDropdownButton");
            const dropdownMenu = document.getElementById("userDropdownMenu");

            // Check if the click is outside the dropdownButton and dropdownMenu
            if (!dropdownButton.contains(e.target) && !dropdownMenu.contains(e.target)) {
                dropdownMenu.classList.add("hidden");
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
