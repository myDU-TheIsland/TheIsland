@using System.Security.Claims
@inject TheIsland.Core.Services.PlayerLinkingService _playerLinkingService
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TheIsland</title>
    <meta content='width=device-width, initial-scale=1.0, shrink-to-fit=no' name='viewport' />
    <!--     Fonts and icons     -->
    <link rel="stylesheet" type="text/css" href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700|Roboto+Slab:400,700|Material+Icons" />
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/font-awesome/latest/css/font-awesome.min.css">
    <!-- CSS Files -->
    <link href="~/css/material-dashboard.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="dark-edition off-canvas-sidebar" style="background-image: url('/img/starfield.jpg'); background-size: cover;">
    <div class="wrapper wrapper-full-page">
        <div>
            <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
                <a class="navbar-brand" href="~/"><img src="/img/ninja-72.png"></a>

                <div class="collapse navbar-collapse" id="navbarSupportedContent">
                    <ul class="navbar-nav mr-auto">

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-toggle="dropdown" aria-expanded="false">About</a>
                            <div class="dropdown-menu">
                                <a class="dropdown-item" asp-controller="Home" asp-action="Community" asp-area="">The Community</a>
                                <a class="dropdown-item" href="https://discord.gg/6zsBcDX5Rz" target="_blank">Our Discord</a>
                            </div>
                        </li>

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-toggle="dropdown" aria-expanded="false">Site Ops</a>
                            <div class="dropdown-menu">
                                <a asp-controller="Market" asp-action="Index" asp-area="" class="dropdown-item">Market Data</a>
                                @if (User?.Identity?.IsAuthenticated ?? false)
                                {
                                    <a class="dropdown-item" asp-area="" asp-controller="User" asp-action="Link">Link Game Account(s)</a>
                                    @if (await _playerLinkingService.HasPlayerMapping(double.Parse(Context.User.Claims.FirstOrDefault(item => item.Type == "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/nameidentifier")?.Value ?? "-1")).ConfigureAwait(false))
                                    {
                                        <a class="dropdown-item" asp-area="" asp-controller="User" asp-action="ImportBP">Blueprints</a>
                                    }
                                    <a asp-controller="Authentication" asp-action="SignOutCurrentUser" class="dropdown-item">Logout</a>
                                } else {
                                    <a asp-controller="Authentication" asp-action="Signin" class="dropdown-item">Sign In</a>
                                }
                            </div>
                        </li>
                    </ul>
                </div>
            </nav>
        </div>
        <div class="container-fluid py-4">
            @RenderBody()
        </div>
    </div>
    <script src="~/js/core/jquery.min.js" asp-append-version="true"></script>
    <script src="~/js/core/popper.min.js" asp-append-version="true"></script>
    <script src="~/js/core/bootstrap-material-design.min.js" asp-append-version="true"></script>
    <script src="~/js/plugins/perfect-scrollbar.jquery.min.js" asp-append-version="true"></script>
    <script src="~/js/plugins/jquery.dataTables.min.js" asp-append-version="true"></script>
    <script src="~/js/material-dashboard.min.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
