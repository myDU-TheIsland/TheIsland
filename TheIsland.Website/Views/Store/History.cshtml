@model StorePurchaseHistory[]
@{
    ViewData["Title"] = "Purchase History";
}
<partial name="_UserData" />
<div class="min-h-screen max-w-7xl mx-auto xs:px-3">
    <div class="bg-darkBlue text-white rounded-lg shadow-md w-full md:p-5 xs:p-2">
        <div class="px-6 py-4 border-b border-gray-700">
            <h2 class="text-xl font-semibold">Purchase History</h2>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full table-auto text-left text-sm">
                <thead class="uppercase text-gray-400 text-xs font-medium">
                    <tr>
                        <th class="py-3">ID</th>
                        <th class="py-3">Date</th>
                        <th class="py-3">Price</th>
                        <th class="py-3">Item</th>
                        <th class="py-3">Status</th>
                    </tr>
                </thead>
                <tbody class="text-gray-300">
                    @foreach (var po in Model)
                    {
                        <tr class="border-b border-gray-700">
                            <td class="py-4 font-semibold">@po.id</td>
                            <td class="py-4">@po.timestamp.ToString("MMM d, yyyy")</td>
                            <td class="py-4">@po.price.ToString("n0") ɦ</td>
                            <td class="py-4">@po.store_item.name</td>
                            <td class="py-4">
                                @if (po.success)
                                {
                                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-gray-800 text-gray-200 border border-gray-600">Completed</span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-red-600 text-white border border-red-800">
                                        <svg class="w-3 h-3 mr-1" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                                        </svg>
                                        Failed
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            var sellTable = $('#sellTable').DataTable();
        });
    </script>
}