@inject TheIsland.Core.Settings.DualUniverseSettings _settings;
@inject StorePurchaseHistoryRepository _storePurchaseHistoryRepository;
@inject IStoreService _storeService;
@model ViewStoreItemModel
@{
    ViewData["Title"] = Model.StoreItem.name;
    bool needTPExplain = Model.StoreItem.description.Contains("{talentPointExplanation}");
    Model.StoreItem.description = Model.StoreItem.description.Replace("{talentPointExplanation}", string.Empty);

    double myPurchaseHistory = (await _storePurchaseHistoryRepository.GetPlayerPurchaseHistory(SelectedPlayer))?.Where(item => item.store_item.id == Model.StoreItem.id)?.Sum(item => item.quantity) ?? 0;
}
<partial name="_UserData" />
<div class="row">
    <div class="col-md-6 ml-auto mr-auto">
        @if (Model.StoreItem.images.Any())
        {
            var images = Model.StoreItem.images.ToArray();

            <div id="itemPageCarousel" class="carousel slide" data-ride="carousel">
                <ol class="carousel-indicators">
                    @for (int x = 0; x < images.Count(); x++)
                    {
                        var className = x == 0 ? "active" : string.Empty;
                        <li data-target="#itemPageCarousel" data-slide-to="@x" class="@className"></li>
                    }
                </ol>
                <div class="carousel-inner">
                    @for (int x = 0; x < images.Count(); x++)
                    {
                        var imageUrl = $@"{_settings.StoreImageUrl}{images[x]}";
                        var className = x == 0 ? "active" : string.Empty;
                        <div class="carousel-item @className">
                            <img src="@imageUrl" class="d-block w-100" alt="...">
                        </div>
                    }
                </div>
                <button class="carousel-control-prev" type="button" data-target="#itemPageCarousel" data-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="sr-only">Previous</span>
                </button>
                <button class="carousel-control-next" type="button" data-target="#itemPageCarousel" data-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="sr-only">Next</span>
                </button>
            </div>
        }
    </div>
</div>

<div class="row">
    <div class="col-md-6  ml-auto mr-auto">
        <div class="card card-product">
            <div class="card-body">
                <h4 class="card-title">
                    @Model.StoreItem.name
                </h4>
                <div class="card-description">
                    @Model.StoreItem.description
                    @if (needTPExplain)
                    {
                        <br />
                        <br />
                        <partial name="_TalentPointInjectorExplanation" />
                    }
                </div>
            </div>
            <div class="card-footer">
                <div class="price">
                    <h4>
                        @Model.StoreItem.price.ToString("n0") &#8463; &nbsp;&nbsp;
                    </h4>
                </div>
                @if (this.IsInGame)
                {
                    <p class="card-category">
                        Please log out to be able to make purchases
                    </p>
                }
                else if (Model.StoreItem.limit > 0 && myPurchaseHistory >= Model.StoreItem.limit)
                    {
                    <p class="card-category">
                        You have reached your limit on this item.
                    </p>                    
                }
                else if (Model.StoreItem.price == 0 && Model.StoreItem.limit == 1 && Model.StoreItem.content.TalentPoints == 10000000 && (await _storeService.GetTalentPoints(this.SelectedPlayer)) > 40000000)
                {
                    <p class="card-category">
                       You have more then 40million talent points. You can no longer purchase this item.
                    </p>
                }
                else
                {
                    StorePurchaseModel purchaseModel = new StorePurchaseModel() { ItemId = Model.StoreItem.id, Quantity = 1};
                    string quantityClass = Model.StoreItem.limit == 1 ? "hidden" : string.Empty;
                    double limit = Model.StoreItem.limit == 0 ? 100 : (Model.StoreItem.limit - myPurchaseHistory);
                    <form asp-action="Purchase" asp-controller="Store" asp-area="" method="post">
                        <p class="card-category">
                            <div class="form-group form-inline">
                                @if (Model.StoreItem.limit == 1)
                                {
                                <input asp-for="@purchaseModel.Quantity" type="number" min="1" max="@limit" type="hidden" />
                                }
                                else
                                {
                                <input asp-for="@purchaseModel.Quantity" type="number" min="1" max="@limit" class="@quantityClass form-control" />
                                }

                                <input asp-for="@purchaseModel.ItemId" class="hidden" type="hidden" /> &nbsp;&nbsp;
                                <button class="btn btn-primary text-right">Buy</button>
                            </div>
                        </p>
                    </form>
                }
            </div>
        </div>
    </div>
</div>