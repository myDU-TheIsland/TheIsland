@inject IStoreService StoreService

<div class="max-w-7xl mx-auto">
    <div class="flex justify-between items-center mb-8">
        <h1 class="text-3xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-pink-600">
            The Isle Store
        </h1>
        <div class="flex items-center space-x-4">
            @{
                var amount = (await StoreService.GetWalletBalance(this.SelectedPlayer)).ToString("n0");
                var talentPoints = (await StoreService.GetTalentPoints(this.SelectedPlayer)).ToString("n0");
            }
            <div class="flex items-center bg-darkBlue rounded-full px-4 py-2">
                <img src="/svg/zap.svg" class="h-5 w-5 mr-2" />
                <span>@talentPoints TP</span>
            </div>
            <div class="flex items-center bg-darkBlue rounded-full px-4 py-2">
                <img src="/svg/wallet-minimal.svg" class="h-5 w-5 mr-2" />
                <span>@amount &#8463;</span>
            </div>
        </div>
    </div>
    <div class="relative mb-8">
        <input type="text" placeholder="Search for items..."
            class="w-full bg-darkBlue text-white placeholder-gray-400 rounded-md py-3 px-6 pl-12 focus:outline-none focus:ring-2 focus:ring-purple-600" />
        <img src="/svg/search.svg" alt="Icon"
            class="w-10 h-10 mx-auto mb-4 absolute left-4 top-1/2 transform -translate-y-1/2 h-5 w-5 text-gray-400" />
    </div>
</div>