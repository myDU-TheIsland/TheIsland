<div class="row align-self-center">
    <div class="col-md-4 offset-md-4">
        <div class="card">
            <h2 class="card-title text-center">Register</h2>
            <div class="card-body">
                <form type="post" action="https://du-backoffice.theisle.online/guest-handler/?handler=OpenCreateAccount" method="post">
                    <div class="form-group has-default">
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text">
                                    <i class="material-icons">mail</i>
                                </span>
                            </div>
                            <br />
                            <input type="text" class="form-control" name="login" placeholder="Login Name / Email">
                        </div>
                    </div>
                    <div class="form-group has-default">
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text">
                                    <i class="material-icons">face</i>
                                </span>
                            </div>
                            <input type="text" class="form-control" name="displayName" placeholder="Player Name">
                        </div>
                    </div>
                    <div class="form-group has-default">
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text">
                                    <i class="material-icons">lock_outline</i>
                                </span>
                            </div>
                            <input type="password" placeholder="Password..." class="form-control" name="password">
                        </div>
                    </div>
                    <div class="text-center">
                        <button class="btn btn-primary btn-round mt-4" value="Get Started" />
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>