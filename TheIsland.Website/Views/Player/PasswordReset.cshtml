@using Microsoft.Extensions.Primitives

@{
    if (!Context.Request.Query.TryGetValue("magic", out StringValues magic))
    {
        magic = StringValues.Empty;
    }
    if (!Context.Request.Query.TryGetValue("accountId", out StringValues accountId))
    {
        accountId = StringValues.Empty;
    }
}

<form type="post" action="https://du-backoffice.theisle.online/guest-handler/?handler=ChangePasswordMagic" method="post">
    <input type="hidden" name="accountId" value="@accountId">
    <input type="hidden" name="magic" value="@magic">
    New password: <input type="password" name="password"><br>
    <button>Update password</button>
</form>