@model LinkUserModel
@{
    ViewData["Title"] = "Link Discord to Player Account";
}

<div class="space-y-4 pt-35">
    <!-- Header Section -->
    <div class="space-y-2 text-center">
        <h1
            class="text-3xl font-bold tracking-tighter sm:text-4xl md:text-5xl lg:text-6xl/none bg-clip-text text-transparent bg-gradient-to-r from-purple-400 to-pink-600">
            Account Connection
        </h1>
        <p class="mx-auto max-w-[600px] text-gray-400 md:text-xl">
            Link your in-game player profile with Discord to access advanced features and seamlessly import blueprints.
        </p>
    </div>

    <div class="max-w-3xl mx-auto space-y-2 xs:px-3">
        <div class="bg-darkBlue text-gray-300 rounded-lg shadow-lg p-6">
            <h2 class="text-xl font-bold mb-4">Link Ingame Player to Discord</h2>
            <form asp-action="LinkUser" class="md:flex md:flex-row xs:flex-col xs:space-x-0 md:space-x-3 text-gray-800">
                <input asp-for="PlayerName" type="text" placeholder="Enter player name"
                    class="max-w-md w-full px-4 py-2 border rounded-md">
                <button
                    class="w-full xs:mt-2 md:mt-0 sm:w-auto bg-purple-600 hover:bg-purple-700 text-white font-semibold py-2 px-4 rounded-md"
                    type="submit">
                    <img src="/svg/link.svg" class="mr-2 h-4 w-4 inline-block" />
                    Find Player
                </button>
            </form>
            <div class="py-3">
                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <p class="text-red-500">@Model.ErrorMessage</p>
                }
            </div>
        </div>
    </div>
</div>
