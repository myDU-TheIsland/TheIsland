@model LinkUserModel
@{
    ViewData["Title"] = "Link Discord to Player Account";
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <p>@Model.ErrorMessage</p>
}
<div class="row">
    <div class="col-md-5">
        <div class="card">
            <div class="card-header">
                <h2 class='text-center'>Link Ingame Player to Discord</h2>
            </div>
            <div class="card-body">
                <form asp-action="LinkUser">
                    <div class="row">
                        <div class="col-6">
                            <label class="form-label">Player Name</label>
                            <div class="input-group">
                                <input asp-for="PlayerName" class="form-control" />
                            </div>
                        </div>
                        <div class="button-row d-flex mt-4">
                            <button class="btn bg-gradient-dark ms-auto mb-0 js-btn-next" type="submit" title="Next">Find Player</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <partial name="_BlueprintInstructions" />
</div>
