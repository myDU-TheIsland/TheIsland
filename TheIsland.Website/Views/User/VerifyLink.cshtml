@model LinkUserConfirmationModel
@{
    ViewData["Title"] = "Verify Code for Link";
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <p>@Model.ErrorMessage</p>
}

<form asp-action="ConfirmLink">
    <div class="card-body pt-0">
        <div class="row">
            <div class="col-6">
                <label class="form-label">Token</label>
                <div class="input-group">
                    @Html.TextBoxFor(model => model.Token, new { @class = "form-control" })
                </div>
            </div>
            <div class="button-row d-flex mt-4">
                <button class="btn bg-gradient-dark ms-auto mb-0 js-btn-next" type="submit" title="Next">Confirm Token</button>
            </div>
        </div>
    </div>
</form>