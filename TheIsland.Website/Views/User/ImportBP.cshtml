@model ImportBPModel
@{
    ViewData["Title"] = "Import Blueprint";
}

<partial name="_Blueprints" />
<div class="text-white font-sans xs:px-3 xs:pb-10">
    <div
        class="max-w-7xl mx-auto md:flex md:flex-row xs:flex-col items-stretch md:space-x-5 md:space-y-0 xs:space-y-5 xs:space-x-0 h-full">
        <!-- Left Side (Upload & Preview) -->
        <div class="flex flex-col md:w-1/2 xs:w-full space-y-5 h-full">
            <!-- Blueprint Preview Section -->
            <div class="bg-darkBlue p-6 rounded-lg shadow-lg flex flex-col items-center flex-grow xs:hidden md:block">
                <div class="aspect-video flex items-center justify-center w-full">
                    <img src="/img/blueprint.jpg?height=300&width=400" class="rounded-md" alt="Blueprint"
                        class="max-w-full max-h-full object-contain" />
                </div>
            </div>

            <!-- Upload Blueprint Section -->
            <form id="import-bp-form" asp-action="ImportBPFile" method="post" enctype="multipart/form-data">
                <div class="bg-darkBlue p-6 rounded-lg shadow-lg flex flex-col items-center flex-grow">
                    <h2 class="text-2xl font-semibold mb-4 text-center">Import Your Blueprints</h2>
                    <div class="mb-4 w-full">
                        <label for="blueprint" class="block text-sm font-medium mb-2">
                            Choose Blueprint Files (JSON
                            format)
                        </label>
                        <div class="flex items-center space-x-4">
                            <label for="blueprint"
                                class="cursor-pointer bg-purple-600 hover:bg-purple-700 text-white px-4 py-2 rounded-md transition-colors flex items-center">
                                Choose Files
                            </label>
                            <span class="text-gray-400" id="file-chosen">No file chosen</span>
                        </div>
                        <input type="file" id="blueprint" accept=".json" class="hidden" name="blueprint" multiple
                            onchange="handleFileChange(event)" />
                    </div>
                    <button type="button"
                        class="w-full bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-md transition-colors flex items-center justify-center"
                        onclick="submitFiles()">
                        Import Blueprint
                    </button>
                </div>
            </form>
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <p class="p-1 text-center text-red-500">@Html.Raw(Model.ErrorMessage)</p>
            }
        </div>

        <!-- Right Side (Instructions) -->
        <div class="bg-darkBlue p-6 rounded-lg shadow-lg md:w-1/2 xs:w-full flex flex-col flex-grow">
            <h2 class="text-2xl font-semibold flex items-center mb-4">Blueprint Import Process</h2>
            <ol class="list-decimal list-inside space-y-2 text-gray-300 text-sm">
                <li>
                    Follow the directions at the MMO's MeshExporter to download the blueprint from the MMO. Use the
                    MeshExporter's "Export" button, not the STL or GLTF buttons.
                </li>
                <li>Start the MyDualUniverse game, connect to the server "[NA East] The Island", and log in.</li>
                <li>
                    If you've not done this yet, select this site's "Site Ops->Sign in" page. It will take you to a
                    Discord account association page; hit the 'Authorize' button.
                </li>
                <li>Select the "Site Ops->Link Game Account" within The Isle's website.</li>
                <li>Enter the user name for your MyDU account (case Sensitive) and click search.</li>
                <li>
                    Within the MyDU chat window (lower left corner of the game), you'll see a message from the TheIsle
                    bot, with a text token string.
                </li>
                <li>Enter the token string into the web site's token form field.</li>
                <li>
                    Once linked, other functions within the "Site Ops" menu will become visible. Click on the "Upload
                    Blueprints" option, and select your blueprint.
                </li>
                <li>Within your nanopack in game, you'll find the blueprint you've uploaded.</li>
                <li>
                    You can now purchase parts from the market or make them in your factory, and deploy your new
                    construct!
                </li>
            </ol>
        </div>
    </div>
</div>

<script>
    function handleFileChange(event) {
        const fileInput = event.target;
        const files = fileInput.files;
        const maxFiles = 10;
        const maxSize = 75 * 1024 * 1024; // 75MB in bytes

        let totalSize = 0;
        let fileNames = [];

        if (files.length > maxFiles) {
            alert(`You can only upload up to ${maxFiles} files.`);
            fileInput.value = ""; // Clear the file input
            document.getElementById('file-chosen').textContent = 'No file chosen';
            return;
        }

        for (const file of files) {
            totalSize += file.size;
            fileNames.push(file.name);
        }

        if (totalSize > maxSize) {
            alert(`Total file size must not exceed ${maxSize / (1024 * 1024)} MB.`);
            fileInput.value = ""; // Clear the file input
            document.getElementById('file-chosen').textContent = 'No file chosen';
            return;
        }

        document.getElementById('file-chosen').textContent = fileNames.join(', ');
    }

    function submitFiles() {
        const fileInput = document.getElementById('blueprint');
        if (!fileInput.files.length) {
            alert("Please select files to upload.");
            return;
        }

        // Here you could perform further validations or submit the form.
        ///alert("Files ready to be uploaded.");
        document.getElementById('import-bp-form').submit();
    }
</script>
