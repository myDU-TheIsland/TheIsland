  <script>
    const Core = [];
    const AtmosphericEngine = [];
    const SpaceEngine = [];
    const Hovercraft = [];
    const VerticalBooster = [];
    const RadarPVPUnitAtmo = [];
    const RadarPVPUnitSpace = [];
    const GunnerControlUnit = [];
    const Weapons = [];
    const Shield = [];
    const Containers = [];
    const Misc = [];

    function handleFileChange(event) {
      // Clear all arrays
      Core.length = 0;
      AtmosphericEngine.length = 0;
      SpaceEngine.length = 0;
      Hovercraft.length = 0;
      VerticalBooster.length = 0;
      RadarPVPUnitAtmo.length = 0;
      RadarPVPUnitSpace.length = 0;
      GunnerControlUnit.length = 0;
      Weapons.length = 0;
      Shield.length = 0;
      Containers.length = 0;
      Misc.length = 0;

      // Reset construct name 
      document.getElementById("constructName").value = "";
      // Reset styles for all core types
      document.getElementById("coreStatic").classList.remove("bg-purple-500", "rounded-md");
      document.getElementById("coreDynamic").classList.remove("bg-purple-500", "rounded-md");
      document.getElementById("coreSpace").classList.remove("bg-purple-500", "rounded-md");
      // Reset all Table bodys
      document.getElementById("AtmosphericEngine").innerHTML = "";
      document.getElementById("SpaceEngine").innerHTML = "";
      document.getElementById("Hovercraft").innerHTML = "";
      document.getElementById("VerticalBooster").innerHTML = "";
      document.getElementById("RadarPVPUnitAtmo").innerHTML = "";
      document.getElementById("RadarPVPUnitSpace").innerHTML = "";
      document.getElementById("GunnerControlUnit").innerHTML = "";
      document.getElementById("Weapons").innerHTML = "";
      document.getElementById("Shield").innerHTML = "";
      document.getElementById("Containers").innerHTML = "";
      document.getElementById("Misc").innerHTML = "";
      // Reset file size
      document.getElementById("fileSize").innerHTML = ""
      // Reset element count
      document.getElementById("elementCount").innerHTML = "";

      document.getElementById("loaded").classList.add("hidden");

      const fileInput = event.target;
      const files = fileInput.files;
      const maxFiles = 1;
      const maxSize = 75 * 1024 * 1024; // 75MB in bytes

      let totalSize = 0;
      let fileNames = [];

      if (files.length > maxFiles) {
        alert(`You can only upload up to ${maxFiles} files.`);
        fileInput.value = ""; // Clear the file input
        document.getElementById('file-chosen').textContent = 'No file chosen';
        return;
      }

      for (const file of files) {
        totalSize += file.size;
        fileNames.push(file.name);
      }

      if (totalSize > maxSize) {
        alert(`Total file size must not exceed ${maxSize / (1024 * 1024)} MB.`);
        fileInput.value = ""; // Clear the file input
        document.getElementById('file-chosen').textContent = 'No file chosen';
        return;
      }

      document.getElementById('file-chosen').textContent = fileNames.join(', ');

      // Reader to load the JSON file
      const reader = new FileReader();
      reader.onload = function (event) {
        try {
          // Parse the JSON and store a deep copy of the original content
          originalJsonContent = JSON.parse(event.target.result);
          jsonContent = JSON.parse(JSON.stringify(originalJsonContent)); // Make a deep copy

          fileSize = (files[0].size / (1024 * 1024)).toFixed(1);
          // Extract the Elements array
          extractedElements = jsonContent.Elements || [];
          extractedLinks = jsonContent.Links || [];
          // Set element count
          elementCount = extractedElements.length;
          console.log("Extracted Elements:", extractedElements);

        } catch (error) {
          console.error("Error parsing JSON:", error);
          alert("Invalid JSON file format. File must be .json!");
        }
      };

      // Trigger file reading
      reader.readAsText(files[0]);
    }

    let originalJsonContent = {}; // To store the original JSON structure

    let jsonContent = {}

    let extractedLinks = []
    let extractedName = "";
    let extractedKind = "";
    let extractedElements = [];
    let fetchedItems = [];
    let fileSize = "";
    let elementCount = "";

    // Event listener to update Name when the input changes
    document.getElementById("constructName").addEventListener("input", (event) => {
      jsonContent.Model.Name = event.target.value;
    });

    document.getElementById("save").addEventListener("click", () => {
      // Create a new copy of the original JSON to update
      const updatedJsonContent = JSON.parse(JSON.stringify(originalJsonContent));

      // Update only specific fields
      updatedJsonContent.Model.Name = jsonContent.Model.Name;
      updatedJsonContent.Model.JsonProperties.kind = jsonContent.Model.JsonProperties.kind;
      updatedJsonContent.Model.Static = jsonContent.Model.Static;
      updatedJsonContent.Model.FreeDeploy = false;

      // Compile all elements into the Elements array, filtering out empty arrays
      const elementArrays = [
        Core,
        AtmosphericEngine,
        SpaceEngine,
        Hovercraft,
        VerticalBooster,
        RadarPVPUnitAtmo,
        RadarPVPUnitSpace,
        GunnerControlUnit,
        Weapons,
        Shield,
        Containers,
        Misc,
      ];

      const compiledElements = elementArrays
        .filter(array => array && array.length > 0) // Filter out empty or undefined arrays
        .flat();

      updatedJsonContent.Elements = compiledElements;
      updatedJsonContent.Links = extractedLinks;

      // Convert updated JSON to a JSON string
      const updatedJsonString = JSON.stringify(updatedJsonContent, null, 2);

      // Create a filename based on extractedName, replacing spaces with underscores
      const fileName = `${(updatedJsonContent.Model.Name || 'Construct').replace(/\s+/g, '_')}_updated.json`;

      // Create a Blob with the updated JSON string
      const blob = new Blob([updatedJsonString], { type: "application/json" });

      // Create a temporary link element for downloading
      const downloadLink = document.createElement("a");
      downloadLink.href = URL.createObjectURL(blob);
      downloadLink.download = fileName;

      // Programmatically click the download link to trigger the download
      downloadLink.click();

      // Clean up the URL object
      setTimeout(() => {
        URL.revokeObjectURL(downloadLink.href);
      }, 100);
    });

    // Function to update Core element based on selected core type
    function updateCoreElementType(coreTypeName, coreKindValue, isStatic) {
      // Update the core kind in jsonContent
      jsonContent.Model.JsonProperties.kind = coreKindValue;
      jsonContent.Model.Static = isStatic;

      // Get the first object in the Core array (assuming only one Core element)
      const coreElement = Core[0];
      if (!coreElement) {
        console.warn("No core element found in the Core array.");
        return;
      }

      // Get the current display name of the core element from fetchedItems
      const currentItem = fetchedItems.find(item => item.id === coreElement.elementType);
      if (!currentItem) {
        console.warn("No item found in fetchedItems for the core element.");
        return;
      }

      // Modify the display name to update the core type
      const currentDisplayName = currentItem.displayName;
      const modifiedDisplayName = currentDisplayName.replace(/^\w+/, coreTypeName); // Replace first word with coreTypeName

      // Search fetchedItems for the modified displayName to get the new elementType
      const newItem = fetchedItems.find(item => item.displayName === modifiedDisplayName);
      if (!newItem) {
        console.warn(`No item found in fetchedItems with displayName "${modifiedDisplayName}".`);
        return;
      }

      // Update the elementType in the Core array
      coreElement.elementType = newItem.id;
      console.log(`Updated core elementType to ${newItem.id} for displayName "${modifiedDisplayName}".`);

      // Update the UI
      updateCoreTypeUI(coreKindValue);
    }

    // Event listeners for core type selection
    document.getElementById("coreStatic").addEventListener("click", () => {
      updateCoreElementType("Static", 3, true);
    });

    document.getElementById("coreDynamic").addEventListener("click", () => {
      updateCoreElementType("Dynamic", 4, false);
    });

    document.getElementById("coreSpace").addEventListener("click", () => {
      updateCoreElementType("Space", 5, true);
    });

    // Function to update the UI based on the selected core type
    function updateCoreTypeUI(selectedKind) {
      // Clear the classes from all core elements
      document.getElementById("coreStatic").classList.remove("bg-purple-500", "rounded-md");
      document.getElementById("coreDynamic").classList.remove("bg-purple-500", "rounded-md");
      document.getElementById("coreSpace").classList.remove("bg-purple-500", "rounded-md");

      // Add classes to the selected core type
      if (jsonContent.Model.JsonProperties.kind === 3) {
        document.getElementById("coreStatic").classList.add("bg-purple-500", "rounded-md");
