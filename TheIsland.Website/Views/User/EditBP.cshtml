            class="flex flex-grow gap-1 items-center justify-between text-center rounded-md border border-gray-500 p-1 w-1/2">
            <p id="coreStatic" class="w-1/3 p-0.5 cursor-pointer">St</p>
            <p id="coreDynamic" class="w-1/3 p-0.5 cursor-pointer">Dy</p>
