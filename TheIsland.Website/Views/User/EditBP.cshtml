          let selectedType = typeSelect.value;

          // Adjust Type to "Maneuver" if Tier changes from "Basic" and Type is "Basic"
          if (selectedTier !== "Basic" && selectedType === "Basic") {
            selectedType = "Optimised";
            typeSelect.value = "Optimised";
          }

          if (selectedTier === "Basic" && selectedType !== "Basic") {
            selectedType = "Basic";
            typeSelect.value = "Basic";
          } else if (selectedType === "Basic" && selectedTier !== "Basic") {
            selectedTier = "Basic";
            tierSelect.value = "Basic";
          }

          // Construct displayName based on model (Flat or regular)
          const newDisplayName = selectedType === "Basic"
            ? `${selectedTier} Container ${defaultSize}`
            : `${selectedTier} ${selectedType} Container ${defaultSize}`;

          // Find the new elementType based on the constructed displayName
          const newMatchedItem = fetchedItems.find(item => item.displayName === newDisplayName);

          if (newMatchedItem) {
            element.elementType = newMatchedItem.id;
            console.log(`Updated elementType to ${newMatchedItem.id} for displayName "${newDisplayName}"`);
          } else {
            console.warn(`No item found with displayName "${newDisplayName}"`);
          }
        }

        // Attach event listeners to the dropdowns
        tierSelect.addEventListener("change", updateElementType);
        typeSelect.addEventListener("change", updateElementType);
      });
    }

    // Function to parse elements based on fetched items
    function parseElements() {
      if (extractedElements.length === 0) {
        alert("No elements to parse. Please upload a valid JSON file first.");
        return;
      }

      // Set extracted construct name 
      document.getElementById("constructName").value = jsonContent.Model.Name;

      // Set file size
      document.getElementById("fileSize").innerHTML = `${fileSize}MB`;

      // Set element count
      document.getElementById("elementCount").innerHTML = elementCount;

      // Categorize each element based on the `elementType` in extracted elements
      extractedElements.forEach(element => {
        const matchedItem = fetchedItems.find(item => item.id === element.elementType);

        if (matchedItem) {
          switch (matchedItem.grandParentName) {
            case 'AtmosphericEngine':
              AtmosphericEngine.push(element);
              break;
            case 'SpaceEngine':
              SpaceEngine.push(element);
              break;
            case 'Hovercraft':
              Hovercraft.push(element);
              break;
            case 'VerticalBooster':
              VerticalBooster.push(element);
              break;
            case 'RadarPVPUnit':
              if (matchedItem.displayName.includes('Atmospheric')) {
                RadarPVPUnitAtmo.push(element);
              } else if (matchedItem.displayName.includes('Space')) {
                RadarPVPUnitSpace.push(element);
              }
              break;
            case 'RadarPvPSpace':
              if (matchedItem.displayName.includes('Atmospheric')) {
                RadarPVPUnitAtmo.push(element);
              } else if (matchedItem.displayName.includes('Space')) {
                RadarPVPUnitSpace.push(element);
              }
              break;
            case 'ControlUnit':
              if (matchedItem.displayName.includes('Gunner Module')) {
                GunnerControlUnit.push(element);
              }
              break;
            case 'ShieldGeneratorUnit':
              Shield.push(element);
              break;
            case 'ItemContainer':
              if (!matchedItem.displayName.includes('Admin')) {
                Containers.push(element);
              }
              break;
            case 'CoreUnit':
              Core.push(element);
              break;
            default:
              if (matchedItem.grandParentName.includes('Weapon')) {
                Weapons.push(element);
              } else {
                if (!matchedItem.grandParentName.includes('CoreUnit')) {
                  Misc.push(element);
                }
              }
              break;
          }
        } else {
          Misc.push(element);
        }
      });

      // Console log the groups for verification
      console.log("ConstructName:", extractedName)
      console.log("Core:", Core);
      console.log("AtmosphericEngine:", AtmosphericEngine);
      console.log("SpaceEngine:", SpaceEngine);
      console.log("Hovercraft:", Hovercraft);
      console.log("VerticalBooster:", VerticalBooster);
      console.log("RadarPVPUnitAtmo:", RadarPVPUnitAtmo);
      console.log("RadarPVPUnitSpace:", RadarPVPUnitSpace);
      console.log("GunnerControlUnit:", GunnerControlUnit);
      console.log("Weapons:", Weapons);
      console.log("Shield:", Shield);
      console.log("Containers:", Containers);
      console.log("Misc:", Misc);
      console.log("File Size:", fileSize + "MB")

      populateEnginesTables(AtmosphericEngine, "AtmosphericEngine");
      populateEnginesTables(SpaceEngine, "SpaceEngine");
      populateHovercraftTable(Hovercraft, "Hovercraft");
      populateEnginesTables(VerticalBooster, "VerticalBooster");
      populateRadarPVPUnitAtmoTable(RadarPVPUnitAtmo, "RadarPVPUnitAtmo");
      populateRadarPVPUnitSpaceTable(RadarPVPUnitSpace, "RadarPVPUnitSpace");
      populateGunnerControlUnitTable(GunnerControlUnit, "GunnerControlUnit");
      populateWeaponsTable(Weapons, "Weapons");
      populateShieldTable(Shield, "Shield");
      populateContainersTable(Containers, "Containers");
      populateMiscTable(Misc, "Misc");

      updateCoreTypeUI(jsonContent.Model.JsonProperties.kind);

      document.getElementById("loaded").classList.remove("hidden");
    }

    document.querySelector('.bg-purple-600').addEventListener('click', parseElements);

    function submitFiles() {
      // Create a new copy of the original JSON to update
      const updatedJsonContent = JSON.parse(JSON.stringify(originalJsonContent));

      // Update only specific fields
      updatedJsonContent.Model.Name = jsonContent.Model.Name;
      updatedJsonContent.Model.JsonProperties.kind = jsonContent.Model.JsonProperties.kind;
      updatedJsonContent.Model.Static = jsonContent.Model.Static;
      updatedJsonContent.Model.FreeDeploy = false;

      // Compile all elements into the Elements array, filtering out empty arrays
      const elementArrays = [
        Core,
        AtmosphericEngine,
        SpaceEngine,
        Hovercraft,
        VerticalBooster,
        RadarPVPUnitAtmo,
        RadarPVPUnitSpace,
        GunnerControlUnit,
        Weapons,
        Shield,
        Containers,
        Misc,
      ];

      const compiledElements = elementArrays
        .filter(array => array && array.length > 0) // Filter out empty or undefined arrays
        .flat();

      updatedJsonContent.Elements = compiledElements;
      updatedJsonContent.Links = extractedLinks;

      // Convert updated JSON to a JSON string
      const updatedJsonString = JSON.stringify(updatedJsonContent, null, 2);

      // Create a Blob with the updated JSON string
      const blob = new Blob([updatedJsonString], { type: "application/json" });
      const file = new File([blob], `${(updatedJsonContent.Model.Name || 'Construct').replace(/\s+/g, '_')}_updated.json`, { type: "application/json" });

      // Create a DataTransfer object and assign the file to the hidden input
      const dataTransfer = new DataTransfer();
      dataTransfer.items.add(file);
      document.getElementById("blueprintImport").files = dataTransfer.files;

      // Submit the form
      document.getElementById("import-bp-form").submit();
    }

    // Fetch the items data when the page loads
    fetch('/Api/Data/GetPlaceableItems/?type=json')
      .then(response => {
        if (!response.ok) {
          throw new Error('Network response was not ok ' + response.statusText);
        }
        return response.json();
      })
      .then(data => {
        fetchedItems = data;
        console.log("Fetched Items:", fetchedItems);
      })
      .catch(error => {
        console.error('There was a problem with the fetch operation:', error);
      });
  </script>
