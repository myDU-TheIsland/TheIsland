@model ImportBPModel
@{
  ViewData["Title"] = "Edit Blueprint Page";
}

<partial name="_Blueprints" />
<div class="max-w-7xl space-y-3 mx-auto text-white font-sans xs:px-3 md:px-0 xs:pb-10 md:pb-3">
  <!-- Important Note -->
  <div class="space-y-2 rounded-md bg-slate-900 p-4">
    <h4 class="font-medium text-slate-400">Important Note:</h4>
    <p class="text-sm text-slate-400 leading-relaxed">
      Most Sizes are not changeable. You can change the size on Radars, Gunner Seats, and Weapons only. Keep in mind if
      you change a size you may run into overlapping elements. You will have to fix that ingame via build mode. Use at
      your own risk.
    </p>
    <p class="text-sm text-slate-400 leading-normal">
      To quickly reset an element to basic there is a reset button left of the delete button.
    </p>
    <p class="text-sm text-slate-400 leading-normal">
      Core type is changeable but size is not.
    </p>
    <p class="text-sm text-slate-400 leading-normal">
      You may choose to save your blueprint(download) or directly upload it to the current character you are logged in
      on.
    </p>
  </div>
  <!-- Upload -->
  <div class="bg-darkBlue w-full rounded-md px-4 pb-4">
    <div class="flex flex-col justify-center">
      <div class="flex items-center justify-between py-4">
        <label class="text-lg text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-pink-600">
          Upload Blueprint:
        </label>
        <div class="flex items-center gap-2">
          <span id="loaded" class="hidden flex text-green-500 px-2">Blueprint Loaded</span>
        </div>
      </div>
      <div class="flex items-center gap-1">
        <div class="w-5/6">
          <div class="flex items-center bg-gray-700 rounded-md border border-purple-700">
            <label for="blueprint" class="flex w-full cursor-pointer p-2">
              <span class="mr-2">Choose Files</span>
              <span class="text-gray-400" id="file-chosen">No file chosen</span>
            </label>
          </div>
          <input type="file" id="blueprint" accept=".json" class="hidden" name="blueprint"
            onchange="handleFileChange(event)" />
        </div>
        <button class="flex-grow bg-purple-600 hover:bg-purple-700/60 px-4 py-2 rounded-md transition-colors w-28">Parse
          File</button>
        <button id="save"
          class="flex-grow bg-red-500 hover:bg-red-500/60 px-4 py-2 rounded-md transition-colors">Save</button>
        <form id="import-bp-form" asp-action="ImportBPFile" method="post" enctype="multipart/form-data">
          <!-- Hidden file input to hold the JSON file data -->
          <input type="file" id="blueprintImport" accept=".json" name="blueprintImport" class="hidden" />
          <button type="button"
            class="flex-grow bg-blue-600 hover:bg-blue-600/60 px-4 py-2 rounded-md transition-colors"
            onclick="submitFiles()">Import</button>
        </form>
      </div>
    </div>
  </div>
