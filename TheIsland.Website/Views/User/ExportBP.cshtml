@model ExportBPModel
@{
    ViewData["Title"] = "Export Blueprint";
}

<div class="min-h-screen text-white font-sans overflow-y-hidden pt-35">
    <div class="grid gap-4 md:grid-cols-2 text-white font-sans max-w-7xl mx-auto">
        <div class="bg-darkBlue border-slate-800 rounded-md p-5">
            <div class="flex flex-row items-center justify-between">
                <div class="text-slate-50 flex items-center gap-2">
                    <img src="/svg/file-up.svg" class="w-6 h-6" />
                    <h2 class="text-xl font-semibold">Export Blueprint</h2>
                </div>
                <div class="bg-gray-600 px-3 rounded-full">
                    <!--Total count for BPs in inventory -->
                    <p>@Model.ExportableBPs.Count Available</p>
                </div>
            </div>
            <div class="py-3">
                <table id="export" class="w-full text-left text-sm text-gray-300">
                    <thead>
                        <tr class="uppercase text-xs text-gray-400 font-medium border-b border-gray-600">
                            <th class="py-4 px-6">Name</th>
                            <th class="py-4 px-6">Type</th>
                            <th class="py-4 px-6">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var bp in Model.ExportableBPs)
                        {
                            if (Model.ExportedBPs.Any(item => item.blueprint_id == bp.Key))
                            {
                                continue;
                            }

                            <tr class="border-b border-gray-700 hover:bg-slate-900">
                                <td class="py-4 px-6 font-semibold">@bp.Key</td>
                                <td class="py-4 px-6">
                                    <div class="flex items-center gap-2">
                                        <img src="/svg/package-static.svg" class="w-4 h-4" alt="Type Icon" />
                                        <p>Static</p>
                                    </div>
                                </td>
                                <td class="py-4 px-6">
                                    <form asp-action="GenerateBP" asp-controller="User" asp-area="" method="post">
                                        <input type="hidden" asp-for="@Model.SelectedBP" value="@bp.Value" />
                                        <input type="hidden" asp-for="@Model.SelectedBPName" value="@bp.Key" />
                                        <button
                                            class="flex items-center gap-2 bg-purple-600 hover:bg-purple-700 text-gray-200 px-3 py-1 rounded-md text-sm">
                                            <img src="/svg/file-up.svg" class="w-4 h-4" alt="Export Icon" />
                                            Export
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="bg-darkBlue border-slate-800 rounded-md p-5">
            <div class="flex flex-row items-center justify-between">
                <div class="text-slate-50 flex items-center gap-2">
                    <img src="/svg/file-down.svg" class="w-6 h-6" />
                    <h2 class="text-xl font-semibold">Downloadable Blueprints</h2>
                </div>
                <div class="bg-gray-600 px-3 rounded-full">
                    <!--Total count for BPs ready for download -->
                    <p>@Model.ExportedBPs.Length Available</p>
                </div>
            </div>
            <div class="py-3">
                <table id="export" class="w-full text-left text-sm text-gray-300">
                    <thead>
                        <tr class="uppercase text-xs text-gray-400 font-medium border-b border-gray-600">
                            <th class="py-4 px-6">Date</th>
                            <th class="py-4 px-6">Name</th>
                            <th class="py-4 px-6">TYPE</th>
                            <th class="py-4 px-6">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var bp in Model.ExportedBPs)
                        {
                            <tr class="border-b border-gray-700 hover:bg-slate-900">
                                <td class="py-4 px-6 font-semibold">@bp.timestamp</td>
                                <td class="py-4 px-6 font-semibold">@bp.blueprint_name</td>
                                <td class="py-4 px-6">
                                    <div class="flex items-center gap-2">
                                        <img src="/svg/package-static.svg" class="w-4 h-4" alt="Type Icon" />
                                        <p>Static</p>
                                    </div>
                                </td>
                                <td class="py-4 px-6">
                                    <div class="bg-purple-600 hover:bg-purple-700 text-gray-200 rounded-md text-sm">
                                    <a asp-action="GetBP"
                                    asp-route-guid="@bp.uuid" class="flex items-center mx-auto gap-2 py-1 px-3 text-sm">
                                        <img src="/svg/file-down.svg" class="w-4 h-4" alt="Downlaod Icon" />
                                        Download
                                    </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
