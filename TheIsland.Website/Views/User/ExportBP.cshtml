@model ExportBPModel
@{
    ViewData["Title"] = "Export Blueprint";
}

<div class="row">
    <div class="col-md-5 pt-0">
        <div class="card">
            <div class="card-header">
                <h3 class='text-center'>Export Blueprint</h3>
            </div>
            <div class="card-body">
                <table id="export" class="table table-striped table-no-bordered table-hover" cellspacing="0" width="100%" style="width:100%">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var bp in Model.ExportableBPs)
                        {
                            if (Model.ExportedBPs.Any(item => item.blueprint_id == bp.Key))
                            {
                                continue;
                            }

                            <tr>
                                <td>@bp.Key</td>
                                <td>
                                    <form asp-action="GenerateBP" asp-controller="User" asp-area="" method="post">
                                        <input type="hidden" asp-for="@Model.SelectedBP" value="@bp.Value" />
                                        <input type="hidden" asp-for="@Model.SelectedBPName" value="@bp.Key" />
                                        <button class="btn btn-fill btn-primary">Export</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-md-5 pt-0">
        <div class="card">
            <div class="card-header">
                <h3 class='text-center'>Exported BPs</h3>
            </div>
            <div class="card-body">
                <table id="export" class="table table-striped table-no-bordered table-hover" cellspacing="0" width="100%" style="width:100%">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Name</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var bp in Model.ExportedBPs)
                        {
                            <tr>
                                <td>@bp.timestamp</td>
                                <td>@bp.blueprint_name</td>
                                <td><a class="btn btn-fill btn-primary" asp-action="GetBP" asp-route-guid="@bp.uuid">Download </a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
