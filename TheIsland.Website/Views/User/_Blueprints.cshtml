@{
  ViewData["Title"] = "Blueprints Page";
}

<div class="max-w-7xl mx-auto pt-35 xs:px-3 md:px-0 xs:pb-10 md:pb-3">
  <div>
    <h1
      class="text-3xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-pink-600 xs:pb-5 xs:text-center">
      Blueprint Manager
    </h1>
  </div>
  <div class="flex items-center justify-between bg-darkBlue rounded-md text-gray-200 space-x-2 p-1.5 w-full">
    <a asp-area="" asp-controller="User" asp-action="ImportBP"
      class="w-1/3 text-center p-1.5 @(ViewData["ActiveAction"]?.ToString() == "ImportBP" ? "bg-purple-500 rounded-md" : "")">Import
      Blueprints</a>
    <a asp-area="" asp-controller="User" asp-action="ExportBP"
      class="w-1/3 text-center p-1.5 @(ViewData["ActiveAction"]?.ToString() == "ExportBP" ? "bg-purple-500 rounded-md" : "")">Export
      Blueprints</a>
    <a asp-area="" asp-controller="User" asp-action="EditBP"
      class="w-1/3 text-center p-1.5 @(ViewData["ActiveAction"]?.ToString() == "EditBP" ? "bg-purple-500 rounded-md" : "")">Edit
      Blueprint</a>
  </div>
</div>