@inject IMarketBot _marketBot
@model StoreItemModel
@{
    ViewData["Title"] = "Home Page";
    ViewBag.InsertGutter = true;

    if (Model.StoreItem.content == null)
    {
        Model.StoreItem.content = new StoreItemContent();
    }

    int itemCount = Model.StoreItem.content?.Items.Count() ?? 0;
    int skinCount = Model.StoreItem.content?.Skins.Count() ?? 0;

    var allItemsData = _marketBot.GetAllItems();
    var allItemsJson = System.Text.Json.JsonSerializer.Serialize(allItemsData);
}

<div class="pt-35">
    <div class="w-full max-w-6xl mx-auto bg-darkBlue rounded-md p-5">
        <form asp-action="SaveItem" asp-controller="Store" asp-area="Admin" method="post" enctype="multipart/form-data"
            class="flex space-x-4">
            <div class="space-y-4 border-r border-gray-700 pr-4 w-2/5">
                <div class="py-3">
                    <h2 class="text-xl font-bold">Configure Item</h2>
                </div>
                <input type="hidden" asp-for="StoreItem.id" />
                <!-- Basic Info -->
                <div class="space-y-3">
                    <h3 class="font-semibold">Basic Info</h3>
                    <div class="grid gap-4 sm:grid-cols-2">
                        <div class="flex flex-col space-y-2">
                            <label asp-for="StoreItem.name"></label>
                            <input asp-for="StoreItem.name" class="bg-gray-700 py-1 px-2 rounded-md text-gray-100" />
                        </div>
                        <div class="flex flex-col space-y-2">
                            <label asp-for="StoreItem.icon"></label>
                            <input asp-for="StoreItem.icon" class="bg-gray-700 py-1 px-2 rounded-md text-gray-100" />
                        </div>
                    </div>
                    <div class="flex flex-col space-y-2">
                        <label asp-for="StoreItem.description"></label>
                        <input asp-for="StoreItem.description" class="bg-gray-700 py-1 px-2 rounded-md text-gray-100" />
                    </div>
                </div>

                <div class="border border-gray-700"></div>

                <!-- Purchase Settings -->
                <div class="space-y-4">
                    <h3 class="font-semibold">Purchase Settings</h3>
                    <div class="grid gap-4 sm:grid-cols-2">
                        <div class="flex flex-col space-y-2">
                            <label asp-for="StoreItem.limit"></label>
                            <input asp-for="StoreItem.limit" class="bg-gray-700 py-1 px-2 rounded-md text-gray-100" />
                        </div>
                        <div class="flex flex-col space-y-2">
                            <label asp-for="StoreItem.price"></label>
                            <input asp-for="StoreItem.price" class="bg-gray-700 py-1 px-2 rounded-md text-gray-100" />
                        </div>
                    </div>
                    <div class="flex items-center space-x-2">
                        <input type="checkbox" asp-for="StoreItem.is_active" />
                        <label asp-for="StoreItem.is_active">Available for Sale</label>
                    </div>
                </div>

                <div class="border border-gray-700"></div>

                <!-- Items & Skins -->
                <div class="space-y-4">
                    <h3 class="font-semibold">Images</h3>
                    <div class="grid gap-4">
                        <div class="grid grid-cols-2 gap-4 text-sm font-medium">
                            <div>Image Path</div>
                        </div>
                        <div class="border border-gray-700 rounded-md p-2">
                            <Input asp-for="Images" type="file" class="w-full" />
                        </div>
                    </div>
                </div>

                <!-- Save Button -->
                <button class="w-full bg-purple-600 rounded-md p-1">Save Changes</button>
            </div>
            <div class="w-3/5">
                <!-- Items & Skins -->
                <div class="space-y-4">
                    <div class="py-3">
                        <h2 class="text-xl font-bold">Rewards</h2>
                    </div>

                    <!-- Talent Point Settings -->
                    <div class="space-y-4">
                        <h3 class="font-semibold">Talent Point Settings</h3>
                        <div class="grid gap-4 sm:grid-cols-2">
                            <div class="flex flex-col space-y-2">
                                <label asp-for="StoreItem.content.TalentPoints"></label>
                                <input asp-for="StoreItem.content.TalentPoints"
                                    class="bg-gray-700 py-1 px-2 rounded-md text-gray-100" />
                            </div>
                            <div class="flex items-center space-x-2 pt-8">
                                <label asp-for="StoreItem.content.RespecTalentPoints"></label>
                                <input asp-for="StoreItem.content.RespecTalentPoints" class="text-black" />
                            </div>
                        </div>
                    </div>

                    <div class="border border-gray-700"></div>

                    <div class="space-y-2">
                        <h3 class="font-semibold">Items</h3>
                        <div class="overflow-auto">
                            <table class="table-fixed w-full">
                                <thead>
                                    <tr class="bg-gray-800 text-gray-100 text-left">
                                        <th class="w-1/2 p-2">Item Id</th>
                                        <th class="w-1/4 p-2">Item Count</th>
                                        <th class="w-1/4 p-2">Actions <a class="add-item"><i
                                                    class="fa-solid fa-plus"></i></a></th>
                                    </tr>
                                </thead>
                                <tbody id="items">
                                    @for (int x = 0; x < Model.StoreItem.content!.Items.Count(); x++)
                                    {
                                        <tr id="items_@x" class="bg-gray-700 text-gray-100">
                                            <td class="p-2">
                                                <select asp-for="@Model.StoreItem.content.Items[@x].Key"
                                                    class="w-full bg-gray-600 border border-gray-500 rounded-md p-2 text-gray-100">
                                                </select>
                                            </td>
                                            <td class="p-2">
                                                <input asp-for="@Model.StoreItem.content.Items[@x].Value"
                                                    class="w-full bg-gray-600 border border-gray-500 rounded-md p-2 text-gray-100" />
                                            </td>
                                            <td class="p-2 text-center">
                                                <a class="delete text-red-500 hover:text-red-700"><i
                                                        class="fa-solid fa-trash"></i></a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="space-y-2">
                        <h3 class="font-semibold">Skins</h3>
                        <div class="overflow-x-auto">
                            <table class="table-fixed w-full">
                                <thead>
                                    <tr class="bg-gray-800 text-gray-100 text-left">
                                        <th class="w-1/2 p-2">Item Id</th>
                                        <th class="w-1/4 p-2">Skin Name</th>
                                        <th class="w-1/4 p-2">Actions <a class="add-skin"><i
                                                    class="fa-solid fa-plus"></i></a></th>
                                    </tr>
                                </thead>
                                <tbody id="skins">
                                    @for (int x = 0; x < Model.StoreItem.content!.Skins.Count(); x++)
                                    {
                                        <tr id="skins_@x" class="bg-gray-700 text-gray-100">
                                            <td class="p-2">
                                                <select asp-for="@Model.StoreItem.content.Skins[@x].Key"
                                                    class="w-full bg-gray-600 border border-gray-500 rounded-md p-2 text-gray-100">
                                                </select>
                                            </td>
                                            <td class="p-2">
                                                <input asp-for="@Model.StoreItem.content.Skins[@x].Value"
                                                    class="w-full bg-gray-600 border border-gray-500 rounded-md p-2 text-gray-100" />
                                            </td>
                                            <td class="p-2 text-center">
                                                <a class="delete text-red-500 hover:text-red-700"><i
                                                        class="fa-solid fa-trash"></i></a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // Parse JSON directly from Razor with proper escaping
        var optionsData = JSON.parse('@Html.Raw(allItemsJson)');
        var dataLoaded = true;

        $(document).ready(function () {
            // Populate select elements with preloaded data
            populateSelects($('select.selectpicker'));

            rebindDeletes();
            $(".add-skin").on('click', debounce(appendSkin, 200)); // Debounced click
            $(".add-item").on('click', debounce(appendItem, 200)); // Debounced click
        });

        function populateSelects(selects) {
            if (!optionsData.length) return;

            // Only render the first few items initially
            const initialOptions = optionsData.slice(0, 50).map(item => `<option value="${item.Value}">${item.Key}</option>`).join('');
            selects.each(function () {
                const select = $(this);
                select.empty().append('<option value="">Select Item...</option>' + initialOptions);

                // Initialize Select2 with custom AJAX-like filtering for virtual scrolling
                select.select2({
                    placeholder: "Select Item...",
                    allowClear: true,
                    width: '100%',
                    minimumInputLength: 1,  // Start search after one character input
                    dropdownParent: $('body'),  // Ensures the dropdown is appended to body for absolute positioning
                    ajax: {
                        transport: function (params, success, failure) {
                            const searchTerm = params.data.term || "";
                            const filteredOptions = optionsData.filter(item =>
                                item.Key.toLowerCase().includes(searchTerm.toLowerCase())
                            );

                            const results = filteredOptions.slice(0, 50).map(item => ({
                                id: item.Value,
                                text: item.Key
                            }));

                            success({ results });
                        },
                        delay: 250
                    }
                }).on('select2:open', function () {
                    // Lock scroll on dropdown open
                    const scrollTop = $(window).scrollTop();
                    $('body').css({
                        'position': 'fixed',
                        'top': `-${scrollTop}px`,
                        'width': '100%'
                    });
                }).on('select2:close', function () {
                    // Unlock scroll on dropdown close
                    const scrollTop = Math.abs(parseInt($('body').css('top')));
                    $('body').css({
                        'position': '',
                        'top': '',
                        'width': ''
                    });
                    $(window).scrollTop(scrollTop);
                });
            });
        }

        $(document).ready(function () {
            $('select.selectpicker').on('select2:open', function () {
                // Get current scroll position
                const scrollTop = $(window).scrollTop();

                // Apply styles to lock body scroll
                $('body').css({
                    'position': 'fixed',
                    'top': `-${scrollTop}px`,
                    'width': '100%'
                });
            });

            $('select.selectpicker').on('select2:close', function () {
                // Get the scroll position before unlocking
                const scrollTop = Math.abs(parseInt($('body').css('top')));

                // Remove fixed positioning
                $('body').css({
                    'position': '',
                    'top': '',
                    'width': ''
                });

                // Restore scroll position
                $(window).scrollTop(scrollTop);
            });

            populateSelects($('select.selectpicker'));
        });

        // Additional functions for adding rows and handling deletes
        function appendSkin() {
            const lastRowId = $("#skins").children("tr").last().attr("id") || "skins_-1";
            const lastRow = parseInt(lastRowId.replace("skins_", "")) + 1;

            const row = $(`
                                        <tr id="skins_${lastRow}" class="bg-gray-700 text-gray-100">
                                            <td class="p-2">
                                                <select class="selectpicker w-full bg-gray-600 border border-gray-500 rounded-md p-2 text-gray-100" id="StoreItem_content_Skins_${lastRow}__Key" name="StoreItem.content.Skins[${lastRow}].Key">
                                                    <option value="">Select Item...</option>
                                                </select>
                                            </td>
                                            <td class="p-2">
                                                <input class="w-full bg-gray-600 border border-gray-500 rounded-md p-2 text-gray-100" type="text" id="StoreItem_content_Skins_${lastRow}__Value" name="StoreItem.content.Skins[${lastRow}].Value" value="">
                                            </td>
                                            <td class="p-2 text-center">
                                                <a class="delete text-red-500 hover:text-red-700"><i class="fa-solid fa-trash"></i></a>
                                            </td>
                                        </tr>
                                    `);

            $("#skins").append(row);
            rebindDeletes();

            // Populate select options for the new row
            if (dataLoaded) {
                populateSelects(row.find('select.selectpicker'));
            }
        }

        function appendItem() {
            const lastRowId = $("#items").children("tr").last().attr("id") || "items_-1";
            const lastRow = parseInt(lastRowId.replace("items_", "")) + 1;

            const row = $(`
                                        <tr id="items_${lastRow}" class="bg-gray-700 text-gray-100">
                                            <td class="p-2">
                                                <select class="selectpicker w-full bg-gray-600 border border-gray-500 rounded-md p-2 text-gray-100" id="StoreItem_content_Items_${lastRow}__Key" name="StoreItem.content.Items[${lastRow}].Key">
                                                    <option value="">Select Item...</option>
                                                </select>
                                            </td>
                                            <td class="p-2">
                                                <input class="w-full bg-gray-600 border border-gray-500 rounded-md p-2 text-gray-100" type="text" data-val="true" data-val-number="The field Value must be a number." data-val-required="The Value field is required." id="StoreItem_content_Items_${lastRow}__Value" name="StoreItem.content.Items[${lastRow}].Value" value="0">
                                            </td>
                                            <td class="p-2 text-center">
                                                <a class="delete text-red-500 hover:text-red-700"><i class="fa-solid fa-trash"></i></a>
                                            </td>
                                        </tr>
                                    `);

            $("#items").append(row);
            rebindDeletes();

            // Populate select options for the new row
            if (dataLoaded) {
                populateSelects(row.find('select.selectpicker'));
            }
        }

        function rebindDeletes() {
            $(".delete").off("click").on("click", function () {
                $(this).closest("tr").remove();
            });
        }

        // Debounce function to limit how often appendSkin and appendItem are called
        function debounce(func, wait) {
            let timeout;
            return function (...args) {
                clearTimeout(timeout);
                timeout = setTimeout(() => func.apply(this, args), wait);
            };
        }
    </script>
}
