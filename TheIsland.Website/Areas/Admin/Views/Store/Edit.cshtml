@model StoreItemModel
@{
    ViewData["Title"] = "Home Page";
    ViewBag.InsertGutter = true;

    if (Model.StoreItem.content == null)
    {
        Model.StoreItem.content = new StoreItemContent();
    }

    int itemCount = Model.StoreItem.content?.Items.Count() ?? 0;
    int skinCount = Model.StoreItem.content?.Skins.Count() ?? 0;
}
<div class="row">
    <div class="col-sm">
        <div class="card">
            <div class="card-body">
                <form asp-action="SaveItem" asp-controller="Store" asp-area="Admin" method="post" enctype="multipart/form-data">
                    <input type="hidden" asp-for="StoreItem.id" />
                    <div class="form-group">
                        <label asp-for="StoreItem.name"></label>
                        <input asp-for="StoreItem.name" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label asp-for="StoreItem.description"></label>
                        <input asp-for="StoreItem.description" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label asp-for="StoreItem.limit"></label>
                        <input asp-for="StoreItem.limit" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label asp-for="StoreItem.price"></label>
                        <input asp-for="StoreItem.price" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label asp-for="StoreItem.is_active"></label>
                        <input asp-for="StoreItem.is_active" class="form-check-inline" />
                    </div>

                    <div>
                        <p>What the user will receive?</p>
                        <div class="form-group">
                            <label asp-for="StoreItem.content.TalentPoints"></label>
                            <input asp-for="StoreItem.content.TalentPoints" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label asp-for="StoreItem.content.RespecTalentPoints"></label>
                            <input asp-for="StoreItem.content.RespecTalentPoints" class="form-check-inline" />
                        </div>
                        <div class="form-group">
                            Items:
                            <table>
                                <thead>
                                    <tr>
                                        <th>Item Id</th>
                                        <th>Item Count</th>
                                        <th>Actions (<a class="add-item"><i class="fa-solid fa-plus"></i></a>)</th>
                                    </tr>
                                </thead>
                                <tbody id="items">
                                    @for (int x = 0; x < Model.StoreItem.content!.Items.Count(); x++)
                                    {
                                        <tr id="items_@x"><td><input asp-for="@Model.StoreItem.content.Items[@x].Key" class="form-control form-inline" /></td><td><input asp-for="@Model.StoreItem.content.Items[@x].Value" class="form-control  form-inline" /></td><td><a class="delete"><i class="fa-solid fa-trash"></i></a></td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="form-group">
                            Skins:
                            <table>
                                <thead>
                                    <tr>
                                        <th>Item Id</th>
                                        <th>Skin Name</th>
                                        <th>Actions (<a class="add-skin"><i class="fa-solid fa-plus"></i></a>)</th>
                                    </tr>
                                </thead>
                                <tbody id="skins">
                                    @for (int x = 0; x < Model.StoreItem.content!.Skins.Count(); x++)
                                    {
                                        <tr id="skins_@x"><td><input asp-for="@Model.StoreItem.content.Skins[@x].Key" class="form-control  form-inline" /></td><td><input asp-for="@Model.StoreItem.content.Skins[@x].Value" class="form-control  form-inline" /></td><td><a class="delete"><i class="fa-solid fa-trash"></i></a></td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="form-group">
                            Images:
                            <table>
                                <thead>
                                    <tr>
                                        <th>image path</th>
                                        <th>actions</th>
                                    </tr>
                                </thead>
                                <tbody id="images">
                                    @for (int x = 0; x < Model.StoreItem.images.Count(); x++)
                                    {
                                        <tr id="images_@x"><td><input asp-for="@Model.StoreItem.images[@x]" class="form-control  form-inline" /></td><td><a class="delete"><i class="fa-solid fa-trash"></i></a></td></tr>
                                    }
                                </tbody>
                            </table>

                        </div>
                        <div class="fileinput fileinput-new text-center" data-provides="fileinput">
                            <div>
                                <span class="btn btn-primary btn-round btn-file">
                                    <span class="fileinput-new">Select image</span>
                                    <span class="fileinput-exists">Change</span>
                                    <input asp-for="Images" multiple class="form-control" />
                                </span>
                            </div>
                        </div>
                        <div class="form-group">
                            <button class="btn btn-success">Save</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        $(function () {
            rebindDeletes();
            $(".add-skin").on('click', appendSkin)
            $(".add-item").on('click', appendItem)
        });

        function appendSkin() {

            var lastRow = parseInt(($("#skins").children("tr").last().attr('id') || "").replace("skins_", "") || -1) + 1;

            $("#skins").append('<tr id="skins_' + lastRow + '"><td><input class="form-control  form-inline" type="text" data-val="true" data-val-number="The field Key must be a number." data-val-required="The Key field is required." id="StoreItem_content_Skins_' + lastRow + '__Key" name="StoreItem.content.Skins[' + lastRow + '].Key" value="0"></td><td><input class="form-control  form-inline" type="text" id="StoreItem_content_Skins_' + lastRow + '__Value" name="StoreItem.content.Skins[' + lastRow + '].Value" value=""></td><td><a class="delete"><i class="fa-solid fa-trash"></i></a></td></tr>');
            rebindDeletes();
        }


        function appendItem() {

            var lastRow = parseInt(($("#items").children("tr").last().attr('id') || "").replace("items_", "") || -1) + 1;

            $("#items").append('<tr id="items_' + lastRow + '"><td><input class="form-control form-inline" type="text" data-val="true" data-val-number="The field Key must be a number." data-val-required="The Key field is required." id="StoreItem_content_Items_' + lastRow + '__Key" name="StoreItem.content.Items[' + lastRow + '].Key" value="0"></td><td><input class="form-control  form-inline" type="text" data-val="true" data-val-number="The field Value must be a number." data-val-required="The Value field is required." id="StoreItem_content_Items_' + lastRow + '__Value" name="StoreItem.content.Items[' + lastRow + '].Value" value="0"></td><td><a class="delete"><i class="fa-solid fa-trash"></i></a></td></tr>');
            rebindDeletes();
        }

        function rebindDeletes()
        {
            $("tr > td > .delete").on("click", function () {
                $(this).closest("tr").remove()
            })
        }

    </script>
}