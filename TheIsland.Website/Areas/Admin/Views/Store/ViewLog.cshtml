@inject DualPlayerRepository playerRepo
@model StorePurchaseHistory
@{
    ViewData["Title"] = "Purchase History Log";
    var po = Model;
}
<div class="row">
    <div class="col-md-6  ml-auto mr-auto">
        <div class="card">
            <div class="card-header card-header-info">
                Purchase History
            </div>
            <div class="card-body">
                <table id="detail" class="table table-striped table-no-bordered table-hover" cellspacing="0" width="100%" style="width:100%">
                    <tbody>
                            @{ var playerName = (await playerRepo.GetAsync(po.player_id).ConfigureAwait(false)).display_name; }
                            <tr>
                                <td>@po.id</td>
                                <td>@po.timestamp.ToString("g")</td>
                                <td>@playerName</td>
                                <td>@po.price.ToString("n0")</td>
                                <td>@(po.quantity)x @po.store_item.name</td>
                                <td>@(po.success ? "Purchased" : "Failed")</td>
                                <td><a asp-action="ViewLog" asp-controller="Store" asp-area="Admin" asp-route-purchaseId="@po.id">Log</a></td>
                            </tr>
                    </tbody>
                </table>
                <table id="logs" class="table table-striped table-no-bordered table-hover" cellspacing="0" width="100%" style="width:100%">
                    <tbody>
                        @foreach (var logEntry in po.log)
                        {
                            <tr>
                                <td>@logEntry</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            var sellTable = $('#logs').DataTable();
        });
    </script>
}