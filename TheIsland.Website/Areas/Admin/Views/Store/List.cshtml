@model StoreSearchModel
@{
    ViewData["Title"] = "Home Page";
    ViewBag.InsertGutter = true;
}

<div class="max-w-7xl mx-auto space-y-3">

    <div class="flex bg-darkBlue items-center justify-center rounded-md p-3">
        <form asp-controller="Store" asp-action="List" asp-area="Admin" method="post">
            <input asp-for="@Model.Name" class="rounded-md text-gray-300 bg-gray-600 p-1" placeholder="Name" />
            <button class="btn btn-default">Search</button>
        </form>
    </div>

    <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-3">
        @foreach (var item in Model.StoreItems)
        {
            <div class="bg-darkBlue rounded-lg p-6 flex flex-col items-center text-center">
                <form asp-controller="Store" asp-action="Edit" asp-area="Admin" method="post">
                    <div class="">
                        @{
                            var storeItemModel = new StoreItemModel();
                            storeItemModel.StoreItem = item;
                        }
                        <div class="text-xl font-bold mb-2">@item.name</div>
                        <p class="text-purple-300 mb-4">@item.description</p>
                        <input type="hidden" name="StoreItem.id" value="@storeItemModel.StoreItem.id" />

                    </div>
                    <div><button
                            class="bg-purple-600 hover:bg-purple-700 text-white py-2 px-4 rounded-md transition-colors">Edit</button>
                    </div>
                </form>
            </div>
        }
    </div>
</div>